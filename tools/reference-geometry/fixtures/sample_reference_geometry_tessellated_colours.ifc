ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC indexed colour map reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_tessellated_colours.ifc', '2026-06-26T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#10 = IFCCARTESIANPOINTLIST3D((
  (0.0, 0.0, 0.0),
  (200.0, 0.0, 0.0),
  (200.0, 120.0, 0.0),
  (0.0, 120.0, 0.0),
  (0.0, 0.0, 90.0),
  (200.0, 0.0, 90.0),
  (200.0, 120.0, 90.0),
  (0.0, 120.0, 90.0)
));
#20 = IFCTRIANGULATEDFACESET(#10, .T., (
  (1, 2, 3),
  (1, 3, 4),
  (5, 8, 7),
  (5, 7, 6)
), $, $);
#30 = IFCCOLOURRGBLIST((
  (1.0, 0.0, 0.0),
  (0.0, 0.2, 1.0)
));
#31 = IFCINDEXEDCOLOURMAP(#20, 0.5, #30, (1, 1, 2, 2));
#40 = IFCSHAPEREPRESENTATION($, 'Body', 'Tessellation', (#20));
#41 = IFCPRODUCTDEFINITIONSHAPE($, $, (#40));
#50 = IFCCARTESIANPOINT((400.0, 300.0, 10.0));
#51 = IFCDIRECTION((0.0, 0.0, 1.0));
#52 = IFCDIRECTION((1.0, 0.0, 0.0));
#53 = IFCAXIS2PLACEMENT3D(#50, #51, #52);
#54 = IFCLOCALPLACEMENT($, #53);
#60 = IFCBUILDINGELEMENTPROXY('tessellated-colours-ref-1', $, 'Tessellated coloured reference block', $, $, #54, #41, $, $);
ENDSEC;
END-ISO-10303-21;
