ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC polygonal tessellated reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_polygonal.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#10 = IFCCARTESIANPOINTLIST3D((
  (0.0, 0.0, 0.0),
  (300.0, 0.0, 0.0),
  (300.0, 180.0, 0.0),
  (0.0, 180.0, 0.0),
  (0.0, 0.0, 140.0),
  (300.0, 0.0, 140.0),
  (300.0, 180.0, 140.0),
  (0.0, 180.0, 140.0)
));
#20 = IFCINDEXEDPOLYGONALFACE((1, 2, 3, 4));
#21 = IFCINDEXEDPOLYGONALFACE((5, 8, 7, 6));
#22 = IFCINDEXEDPOLYGONALFACE((1, 5, 6, 2));
#23 = IFCINDEXEDPOLYGONALFACE((2, 6, 7, 3));
#24 = IFCINDEXEDPOLYGONALFACE((3, 7, 8, 4));
#25 = IFCINDEXEDPOLYGONALFACE((4, 8, 5, 1));
#40 = IFCPOLYGONALFACESET(#10, .T., (#20, #21, #22, #23, #24, #25), $);
#50 = IFCSHAPEREPRESENTATION($, 'Body', 'Tessellation', (#40));
#51 = IFCPRODUCTDEFINITIONSHAPE($, $, (#50));
#60 = IFCCARTESIANPOINT((700.0, 200.0, 30.0));
#61 = IFCDIRECTION((0.0, 0.0, 1.0));
#62 = IFCDIRECTION((0.0, 1.0, 0.0));
#63 = IFCAXIS2PLACEMENT3D(#60, #61, #62);
#64 = IFCLOCALPLACEMENT($, #63);
#70 = IFCBUILDINGELEMENTPROXY('polygonal-ref-1', $, 'Polygonal reference block', $, $, #64, #51, $, $);
ENDSEC;
END-ISO-10303-21;
