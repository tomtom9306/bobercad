FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('p1', (0.0, 0.0, 0.0));
#2 = CARTESIAN_POINT('p2', (10.0, 0.0, 0.0));
#3 = CARTESIAN_POINT('p3', (10.0, 20.0, 0.0));
#10 = POLYLINE('', (#1, #2, #3));
#20 = GEOMETRIC_CURVE_SET('', (#10));
#30 = CARTESIAN_POINT('map-origin', (0.0, 0.0, 0.0));
#31 = DIRECTION('map-z', (0.0, 0.0, 1.0));
#32 = DIRECTION('map-x', (1.0, 0.0, 0.0));
