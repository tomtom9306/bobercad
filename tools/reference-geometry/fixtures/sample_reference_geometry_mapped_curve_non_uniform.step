#50 = CARTESIAN_POINT('target-origin', (100.0, 200.0, 300.0));
#51 = DIRECTION('target-x', (1.0, 0.0, 0.0));
#52 = DIRECTION('target-y', (0.0, 1.0, 0.0));
#53 = DIRECTION('target-z', (0.0, 0.0, 1.0));
#54 = CARTESIAN_TRANSFORMATION_OPERATOR_3D_NON_UNIFORM('', #51, #52, #50, 2.0, #53, 3.0, 4.0);
#55 = MAPPED_ITEM(#41, #54);
#56 = SHAPE_REPRESENTATION('', (#55), $);
ENDSEC;
