#84 = CARTESIAN_TRANSFORMATION_OPERATOR_3D('', #81, #82, #80, 1.0, #83);
#85 = MAPPED_ITEM(#71, #84);
#86 = SHAPE_REPRESENTATION('', (#85), $);
ENDSEC;
