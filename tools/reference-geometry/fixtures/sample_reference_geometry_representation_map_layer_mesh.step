#80 = CARTESIAN_POINT('target-origin', (200.0, 30.0, 10.0));
#81 = DIRECTION('target-x', (0.0, 1.0, 0.0));
#82 = DIRECTION('target-y', (-1.0, 0.0, 0.0));
