#20 = POLY_LOOP('', (#1, #2, #3, #4));
#30 = FACE_OUTER_BOUND('', #20, .T.);
#40 = ADVANCED_FACE('', (#30), $, .T.);
#60 = CARTESIAN_POINT('map-origin', (0.0, 0.0, 0.0));
#61 = DIRECTION('map-z', (0.0, 0.0, 1.0));
#62 = DIRECTION('map-x', (1.0, 0.0, 0.0));
