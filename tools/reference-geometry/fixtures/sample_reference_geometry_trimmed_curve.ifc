ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC trimmed curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_trimmed_curve.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((200.0, 50.0));
#2 = IFCDIRECTION((0.0, 1.0));
#3 = IFCAXIS2PLACEMENT2D(#1, #2);
#4 = IFCCIRCLE(#3, 40.0);
#5 = IFCCARTESIANPOINT((20.0, 30.0));
#6 = IFCDIRECTION((0.0, 1.0));
#7 = IFCAXIS2PLACEMENT2D(#5, #6);
#8 = IFCELLIPSE(#7, 60.0, 25.0);
#20 = IFCTRIMMEDCURVE(#4, (IFCPARAMETERVALUE(0.0)), (IFCPARAMETERVALUE(1.5707963267948966)), .T., .PARAMETER.);
#21 = IFCTRIMMEDCURVE(#8, (IFCPARAMETERVALUE(1.5707963267948966)), (IFCPARAMETERVALUE(3.141592653589793)), .T., .PARAMETER.);
#30 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((0.0, 1.0, 0.0));
#33 = IFCLOCALPLACEMENT($, #34);
#34 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve2D', (#20, #21));
#41 = IFCPRODUCTDEFINITIONSHAPE($, $, (#40));
#50 = IFCBUILDINGELEMENTPROXY('trimmed-curve-ref-1', $, 'Trimmed curve reference', $, $, #33, #41, $, $);
ENDSEC;
END-ISO-10303-21;
