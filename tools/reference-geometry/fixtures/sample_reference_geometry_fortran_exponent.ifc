ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC Fortran exponent reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_fortran_exponent.ifc', '2026-06-28T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((1.0D+1, 2.0d+1, 3.0D+1));
#2 = IFCCARTESIANPOINT((4.0D+1, 5.0D+1, 6.0D+1));
#3 = IFCVERTEXPOINT(#1);
#4 = IFCVERTEXPOINT(#2);
#10 = IFCCARTESIANPOINT((1.0D+2, 2.0D+2));
#11 = IFCDIRECTION((1D+0, 0D+0));
#12 = IFCAXIS2PLACEMENT2D(#10, #11);
#13 = IFCCIRCLE(#12, 1.5D+1);
#20 = IFCCARTESIANPOINT((0D+0, 0D+0, 0D+0));
#21 = IFCDIRECTION((0D+0, 0D+0, 1D+0));
#22 = IFCDIRECTION((1D+0, 0D+0, 0D+0));
#23 = IFCAXIS2PLACEMENT3D(#20, #21, #22);
#24 = IFCLOCALPLACEMENT($, #23);
#30 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve2D', (#13));
#31 = IFCPRODUCTDEFINITIONSHAPE($, $, (#30));
#40 = IFCBUILDINGELEMENTPROXY('fortran-exponent-reference', $, 'Fortran exponent reference', $, $, #24, #31, $, $);
ENDSEC;
END-ISO-10303-21;
