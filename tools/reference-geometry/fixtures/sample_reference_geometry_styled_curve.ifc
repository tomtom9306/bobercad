ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD styled curve IFC reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_styled_curve.ifc', '2026-06-28T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((40.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((40.0, 20.0, 0.0));
#4 = IFCDIRECTION((0.0, 0.0, 1.0));
#5 = IFCDIRECTION((1.0, 0.0, 0.0));
#6 = IFCAXIS2PLACEMENT3D(#1, #4, #5);
#7 = IFCLOCALPLACEMENT($, #6);
#10 = IFCPOLYLINE((#1, #2, #3));
#20 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#10));
#21 = IFCPRODUCTDEFINITIONSHAPE($, $, (#20));
#22 = IFCBUILDINGELEMENTPROXY('styled-curve', $, 'Styled magenta curve', $, $, #7, #21, $, $);
#40 = IFCCOLOURRGB('Magenta', 1.0, 0.0, 1.0);
#41 = IFCCURVESTYLE('Magenta curve style', $, $, #40);
#42 = IFCPRESENTATIONSTYLEASSIGNMENT((#41));
#43 = IFCSTYLEDITEM(#10, (#42), $);
ENDSEC;
END-ISO-10303-21;
