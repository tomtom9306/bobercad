ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC invalid curve placement axes fixture'), '2;1');
FILE_NAME('sample_reference_geometry_invalid_curve_placement_axes.ifc', '2026-06-29T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((200.0, 50.0));
#2 = IFCDIRECTION((0.0, 1.0));
#3 = IFCAXIS2PLACEMENT2D(#1, #2);
#4 = IFCCIRCLE(#3, 40.0);
#5 = IFCCARTESIANPOINT((400.0, 50.0));
#6 = IFCDIRECTION((0.0, 0.0));
#7 = IFCAXIS2PLACEMENT2D(#5, #6);
#8 = IFCCIRCLE(#7, 40.0);
#15 = IFCCARTESIANPOINT((600.0, 50.0, 0.0));
#16 = IFCDIRECTION((0.0, 0.0, 1.0));
#17 = IFCDIRECTION((0.0, 0.0, 1.0));
#18 = IFCAXIS2PLACEMENT3D(#15, #16, #17);
#19 = IFCCIRCLE(#18, 40.0);
#30 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((0.0, 1.0, 0.0));
#33 = IFCLOCALPLACEMENT($, #34);
#34 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve2D', (#4, #8, #19));
#41 = IFCPRODUCTDEFINITIONSHAPE($, $, (#40));
#50 = IFCBUILDINGELEMENTPROXY('invalid-curve-placement-axes-ref-1', $, 'Invalid curve placement axes reference', $, $, #33, #41, $, $);
ENDSEC;
END-ISO-10303-21;
