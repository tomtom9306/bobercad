ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD extruded IFC profile void reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_extruded_voids.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#101 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#102 = IFCCARTESIANPOINT((240.0, 0.0, 0.0));
#103 = IFCCARTESIANPOINT((240.0, 180.0, 0.0));
#104 = IFCCARTESIANPOINT((0.0, 180.0, 0.0));
#105 = IFCCARTESIANPOINT((80.0, 60.0, 0.0));
#106 = IFCCARTESIANPOINT((160.0, 60.0, 0.0));
#107 = IFCCARTESIANPOINT((160.0, 120.0, 0.0));
#108 = IFCCARTESIANPOINT((80.0, 120.0, 0.0));
#20 = IFCPOLYLINE((#101, #102, #103, #104));
#21 = IFCPOLYLINE((#105, #106, #107, #108));
#10 = IFCARBITRARYPROFILEDEFWITHVOIDS(.AREA., 'Void profile', #20, (#21));
#11 = IFCDIRECTION((0.0, 0.0, 1.0));
#12 = IFCEXTRUDEDAREASOLID(#10, #4, #11, 200.0);
#30 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#12));
ENDSEC;
END-ISO-10303-21;
