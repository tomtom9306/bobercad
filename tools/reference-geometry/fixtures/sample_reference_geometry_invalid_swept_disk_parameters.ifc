ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC invalid swept disk parameter reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_invalid_swept_disk_parameters.ifc', '2026-06-29T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((100.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((100.0, 60.0, 0.0));
#10 = IFCPOLYLINE((#1, #2, #3));
#20 = IFCSWEPTDISKSOLID(#10, 10.0, $, $, $);
#101 = IFCCARTESIANPOINT((400.0, 0.0, 0.0));
#102 = IFCCARTESIANPOINT((500.0, 0.0, 0.0));
#103 = IFCCARTESIANPOINT((500.0, 60.0, 0.0));
#110 = IFCPOLYLINE((#101, #102, #103));
#120 = IFCSWEPTDISKSOLID(#110, 10.0, $, BAD_VALUE, 130.0);
#130 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#20, #120));
#131 = IFCPRODUCTDEFINITIONSHAPE($, $, (#130));
#140 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#141 = IFCDIRECTION((0.0, 0.0, 1.0));
#142 = IFCDIRECTION((1.0, 0.0, 0.0));
#143 = IFCAXIS2PLACEMENT3D(#140, #141, #142);
#144 = IFCLOCALPLACEMENT($, #143);
#150 = IFCBUILDINGELEMENTPROXY('invalid-swept-disk-parameter-ref-1', $, 'Invalid swept disk parameter reference member', $, $, #144, #131, $, $);
ENDSEC;
END-ISO-10303-21;
