ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC invalid vector direction reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_invalid_vector_direction.ifc', '2026-06-29T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCDIRECTION((1.0, 0.0, 0.0));
#3 = IFCVECTOR(#2, 2.0);
#4 = IFCLINE(#1, #3);
#5 = IFCTRIMMEDCURVE(#4, (IFCPARAMETERVALUE(5.0)), (IFCPARAMETERVALUE(50.0)), .T., .PARAMETER.);
#6 = IFCDIRECTION((0.0, bad, 1.0));
#7 = IFCVECTOR(#6, 2.0);
#8 = IFCLINE(#1, #7);
#9 = IFCTRIMMEDCURVE(#8, (IFCPARAMETERVALUE(5.0)), (IFCPARAMETERVALUE(50.0)), .T., .PARAMETER.);
#20 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#21 = IFCDIRECTION((0.0, 0.0, 1.0));
#22 = IFCDIRECTION((1.0, 0.0, 0.0));
#23 = IFCAXIS2PLACEMENT3D(#20, #21, #22);
#24 = IFCLOCALPLACEMENT($, #23);
#30 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#5, #9));
#31 = IFCPRODUCTDEFINITIONSHAPE($, $, (#30));
#40 = IFCBUILDINGELEMENTPROXY('invalid-vector-direction-ref-1', $, 'Invalid vector direction reference', $, $, #24, #31, $, $);
ENDSEC;
END-ISO-10303-21;
