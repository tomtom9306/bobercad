#32 = DIRECTION('malformed-extrude', (1.0, BAD_VALUE));
#33 = EXTRUDED_AREA_SOLID('', #10, #31, #32, 60.0);
#40 = SHAPE_REPRESENTATION('', (#12, #23, #33), $);
ENDSEC;
