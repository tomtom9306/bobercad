#101 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#102 = IFCCARTESIANPOINT((240.0, 0.0, 0.0));
#103 = IFCCARTESIANPOINT((240.0, 180.0, 0.0));
#104 = IFCCARTESIANPOINT((0.0, 180.0, 0.0));
#105 = IFCCARTESIANPOINT((80.0, 60.0, 0.0));
#106 = IFCCARTESIANPOINT((160.0, 60.0, 0.0));
#107 = IFCCARTESIANPOINT((160.0, 120.0, 0.0));
#108 = IFCCARTESIANPOINT((80.0, 120.0, 0.0));
#20 = IFCPOLYLINE((#101, #102, #103, #104));
#21 = IFCPOLYLINE((#105, #106, #107, #108));
#10 = IFCARBITRARYPROFILEDEFWITHVOIDS(.AREA., 'Mapped void profile', #20, (#21));
#11 = IFCDIRECTION((0.0, 0.0, 1.0));
#12 = IFCEXTRUDEDAREASOLID(#10, #4, #11, 200.0);
#30 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#12));
#41 = IFCREPRESENTATIONMAP(#33, #40);
#50 = IFCCARTESIANPOINT((200.0, 30.0, 10.0));
#51 = IFCDIRECTION((1.0, 0.0, 0.0));
#52 = IFCDIRECTION((0.0, 1.0, 0.0));
#53 = IFCDIRECTION((0.0, 0.0, 1.0));
#54 = IFCCARTESIANTRANSFORMATIONOPERATOR3D(#51, #52, #50, 1.0, #53);
#55 = IFCMAPPEDITEM(#41, #54);
#56 = IFCSHAPEREPRESENTATION($, 'Body', 'MappedRepresentation', (#55));
#57 = IFCPRODUCTDEFINITIONSHAPE($, $, (#56));
#60 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#61 = IFCDIRECTION((0.0, 0.0, 1.0));
#62 = IFCDIRECTION((1.0, 0.0, 0.0));
#63 = IFCAXIS2PLACEMENT3D(#60, #61, #62);
#64 = IFCLOCALPLACEMENT($, #63);
#70 = IFCBUILDINGELEMENTPROXY('mapped-swept-ref-1', $, 'Mapped swept reference block', $, $, #64, #57, $, $);
