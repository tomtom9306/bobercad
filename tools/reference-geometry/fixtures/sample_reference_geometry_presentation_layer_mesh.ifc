#72 = IFCPRODUCTDEFINITIONSHAPE($, $, (#70));
#80 = IFCBUILDINGELEMENTPROXY('presentation-layer-mesh-ref-1', $, 'Presentation layer mesh reference', $, $, #64, #72, $, $);
