FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((120.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((120.0, 80.0, 0.0));
#4 = IFCCARTESIANPOINT((0.0, 80.0, 0.0));
#20 = IFCPOLYLOOP((#1, #2, #3, #4));
#30 = IFCFACEOUTERBOUND(#20, .T.);
#40 = IFCFACE((#30));
#50 = IFCCLOSEDSHELL((#40));
#51 = IFCFACETEDBREP(#50);
#60 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#61 = IFCDIRECTION((0.0, 0.0, 1.0));
