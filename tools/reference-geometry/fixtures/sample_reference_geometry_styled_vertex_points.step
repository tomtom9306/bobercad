ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Styled STEP vertex point reference fixture'),'2;1');
FILE_NAME('sample_reference_geometry_styled_vertex_points.step','2026-06-28T00:00:00',('Codex'),('OpenAI'),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('red-point',(10.,20.,30.));
#2=CARTESIAN_POINT('blue-point',(40.,50.,60.));
#3=VERTEX_POINT('',#1);
#4=VERTEX_POINT('',#2);
#10=SHAPE_REPRESENTATION('',(#3,#4),$);
#20=COLOUR_RGB('Red',1.,0.,0.);
#21=SURFACE_STYLE_RENDERING(#20,0.5,$,$,$,$,$,$,.NOTDEFINED.);
#22=SURFACE_SIDE_STYLE('Red point surface',(#21));
#23=SURFACE_STYLE_USAGE(.BOTH.,#22);
#24=PRESENTATION_STYLE_ASSIGNMENT((#23));
#25=STYLED_ITEM('Red point style',(#24),#3);
#30=COLOUR_RGB('Blue',0.,0.2,1.);
#31=SURFACE_STYLE_RENDERING(#30,0.,$,$,$,$,$,$,.NOTDEFINED.);
#32=SURFACE_SIDE_STYLE('Blue point surface',(#31));
#33=SURFACE_STYLE_USAGE(.BOTH.,#32);
#34=PRESENTATION_STYLE_ASSIGNMENT((#33));
#35=STYLED_ITEM('Blue point style',(#34),#4);
ENDSEC;
END-ISO-10303-21;
