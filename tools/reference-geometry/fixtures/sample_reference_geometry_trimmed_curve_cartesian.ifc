ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC Cartesian trimmed curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_trimmed_curve_cartesian.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((200.0, 50.0));
#2 = IFCDIRECTION((0.0, 1.0));
#3 = IFCAXIS2PLACEMENT2D(#1, #2);
#4 = IFCCIRCLE(#3, 40.0);
#5 = IFCCARTESIANPOINT((20.0, 30.0));
#6 = IFCDIRECTION((0.0, 1.0));
#7 = IFCAXIS2PLACEMENT2D(#5, #6);
#8 = IFCELLIPSE(#7, 60.0, 25.0);
#101 = IFCCARTESIANPOINT((200.0, 90.0));
#102 = IFCCARTESIANPOINT((160.0, 50.0));
#103 = IFCCARTESIANPOINT((-5.0, 30.0));
#104 = IFCCARTESIANPOINT((20.0, -30.0));
#20 = IFCTRIMMEDCURVE(#4, (#101), (#102), .T., .CARTESIAN.);
#21 = IFCTRIMMEDCURVE(#8, (#103), (#104), .T., .CARTESIAN.);
#30 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((0.0, 1.0, 0.0));
#33 = IFCLOCALPLACEMENT($, #34);
#34 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve2D', (#20, #21));
#41 = IFCPRODUCTDEFINITIONSHAPE($, $, (#40));
#50 = IFCBUILDINGELEMENTPROXY('cartesian-trimmed-curve-ref-1', $, 'Cartesian trimmed curve reference', $, $, #33, #41, $, $);
ENDSEC;
END-ISO-10303-21;
