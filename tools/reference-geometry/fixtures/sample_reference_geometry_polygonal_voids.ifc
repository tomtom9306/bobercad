ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC polygonal tessellated void reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_polygonal_voids.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#10 = IFCCARTESIANPOINTLIST3D((
  (0.0, 0.0, 0.0),
  (240.0, 0.0, 0.0),
  (240.0, 180.0, 0.0),
  (0.0, 180.0, 0.0),
  (80.0, 60.0, 0.0),
  (160.0, 60.0, 0.0),
  (160.0, 120.0, 0.0),
  (80.0, 120.0, 0.0)
));
#20 = IFCINDEXEDPOLYGONALFACEWITHVOIDS((1, 2, 3, 4), ((5, 6, 7, 8)));
#40 = IFCPOLYGONALFACESET(#10, .T., (#20), $);
#50 = IFCSHAPEREPRESENTATION($, 'Body', 'Tessellation', (#40));
#51 = IFCPRODUCTDEFINITIONSHAPE($, $, (#50));
#60 = IFCCARTESIANPOINT((700.0, 200.0, 30.0));
#61 = IFCDIRECTION((0.0, 0.0, 1.0));
#62 = IFCDIRECTION((0.0, 1.0, 0.0));
#63 = IFCAXIS2PLACEMENT3D(#60, #61, #62);
#64 = IFCLOCALPLACEMENT($, #63);
#70 = IFCBUILDINGELEMENTPROXY('polygonal-void-ref-1', $, 'Polygonal void reference plate', $, $, #64, #51, $, $);
ENDSEC;
END-ISO-10303-21;
