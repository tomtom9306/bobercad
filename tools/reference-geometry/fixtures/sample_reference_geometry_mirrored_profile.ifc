ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC mirrored profile swept reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_mirrored_profile.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((10.0, 20.0, 30.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#10 = IFCCARTESIANPOINT((60.0, 0.0));
#11 = IFCDIRECTION((1.0, 0.0));
#12 = IFCAXIS2PLACEMENT2D(#10, #11);
#20 = IFCLSHAPEPROFILEDEF(.AREA., 'Parent L profile', #12, 200.0, 120.0, 30.0, 0.0, 0.0);
#21 = IFCMIRROREDPROFILEDEF(.AREA., 'Mirrored L profile', #20, 'left-handed l profile');
#30 = IFCDIRECTION((0.0, 0.0, 1.0));
#31 = IFCEXTRUDEDAREASOLID(#21, #4, #30, 150.0);
#40 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#31));
#41 = IFCPRODUCTDEFINITIONSHAPE($, $, (#40));
#50 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#51 = IFCDIRECTION((0.0, 0.0, 1.0));
#52 = IFCDIRECTION((1.0, 0.0, 0.0));
#53 = IFCAXIS2PLACEMENT3D(#50, #51, #52);
#54 = IFCLOCALPLACEMENT($, #53);
#60 = IFCBUILDINGELEMENTPROXY('mirrored-profile-ref-1', $, 'Mirrored profile reference member', $, $, #54, #41, $, $);
ENDSEC;
END-ISO-10303-21;
