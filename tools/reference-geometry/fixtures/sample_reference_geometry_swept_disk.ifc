ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC swept disk reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_swept_disk.ifc', '2026-06-23T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((100.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((100.0, 60.0, 0.0));
#10 = IFCPOLYLINE((#1, #2, #3));
#20 = IFCSWEPTDISKSOLID(#10, 10.0, $, $, $);
#30 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#20));
#31 = IFCPRODUCTDEFINITIONSHAPE($, $, (#30));
#40 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#41 = IFCDIRECTION((0.0, 0.0, 1.0));
#42 = IFCDIRECTION((1.0, 0.0, 0.0));
#43 = IFCAXIS2PLACEMENT3D(#40, #41, #42);
#44 = IFCLOCALPLACEMENT($, #43);
#50 = IFCBUILDINGELEMENTPROXY('swept-disk-ref-1', $, 'Swept disk reference member', $, $, #44, #31, $, $);
ENDSEC;
END-ISO-10303-21;
