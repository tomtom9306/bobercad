ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC IFCFACEBOUND-only fixture'), '2;1');
FILE_NAME('sample_reference_geometry_face_bound_only.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((200.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((200.0, 200.0, 0.0));
#4 = IFCCARTESIANPOINT((0.0, 200.0, 0.0));
#5 = IFCCARTESIANPOINT((75.0, 75.0, 0.0));
#6 = IFCCARTESIANPOINT((125.0, 75.0, 0.0));
#7 = IFCCARTESIANPOINT((125.0, 125.0, 0.0));
#8 = IFCCARTESIANPOINT((75.0, 125.0, 0.0));
#20 = IFCPOLYLOOP((#1, #2, #3, #4));
#21 = IFCPOLYLOOP((#5, #6, #7, #8));
#30 = IFCFACEBOUND(#20, .T.);
#31 = IFCFACEBOUND(#21, .T.);
#40 = IFCFACE((#30, #31));
#50 = IFCOPENSHELL((#40));
#60 = IFCFACETEDBREP(#50);
#70 = IFCSHAPEREPRESENTATION($, 'Body', 'Brep', (#60));
#71 = IFCPRODUCTDEFINITIONSHAPE($, $, (#70));
#80 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#81 = IFCAXIS2PLACEMENT3D(#80, $, $);
#82 = IFCLOCALPLACEMENT($, #81);
#90 = IFCBUILDINGELEMENTPROXY('face-bound-only-ref-1', $, 'Face bound only reference', $, $, #82, #71, $, $);
ENDSEC;
END-ISO-10303-21;
