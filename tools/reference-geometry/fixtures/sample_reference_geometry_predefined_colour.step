#11 = DIRECTION('extrude-z', (0.0, 0.0, 1.0));
#12 = EXTRUDED_AREA_SOLID('yellow-solid', #10, #4, #11, 5.0);
#20 = SHAPE_REPRESENTATION('', (#12), $);
#40 = DRAUGHTING_PRE_DEFINED_COLOUR('yellow');
#41 = SURFACE_STYLE_RENDERING(#40, 0.0, $, $, $, $, $, $, .NOTDEFINED.);
