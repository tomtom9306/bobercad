#10 = IFCTRIMMEDCURVE(#4, (IFCPARAMETERVALUE(5.0)), (IFCPARAMETERVALUE(50.0)), .T., .PARAMETER.);
#20 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
