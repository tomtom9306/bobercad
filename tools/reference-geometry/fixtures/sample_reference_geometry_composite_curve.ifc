ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC composite curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_composite_curve.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((100.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((100.0, 50.0, 0.0));
#4 = IFCCARTESIANPOINT((100.0, 100.0, 0.0));
#10 = IFCPOLYLINE((#1, #2));
#11 = IFCPOLYLINE((#4, #3, #2));
#20 = IFCCOMPOSITECURVESEGMENT(.CONTINUOUS., .T., #10);
#21 = IFCCOMPOSITECURVESEGMENT(.CONTINUOUS., .F., #11);
#30 = IFCCOMPOSITECURVE((#20, #21), .F.);
#40 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#41 = IFCDIRECTION((0.0, 0.0, 1.0));
#42 = IFCDIRECTION((1.0, 0.0, 0.0));
#43 = IFCAXIS2PLACEMENT3D(#40, #41, #42);
#44 = IFCLOCALPLACEMENT($, #43);
#50 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#30));
#51 = IFCPRODUCTDEFINITIONSHAPE($, $, (#50));
#60 = IFCBUILDINGELEMENTPROXY('composite-curve-ref-1', $, 'Composite curve reference', $, $, #44, #51, $, $);
ENDSEC;
END-ISO-10303-21;
