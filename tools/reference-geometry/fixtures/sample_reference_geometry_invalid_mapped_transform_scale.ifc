#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#10));
#41 = IFCREPRESENTATIONMAP(#33, #40);
#50 = IFCCARTESIANPOINT((200.0, 20.0, 10.0));
#51 = IFCDIRECTION((0.0, 1.0, 0.0));
#52 = IFCDIRECTION((-1.0, 0.0, 0.0));
#53 = IFCDIRECTION((0.0, 0.0, 1.0));
#54 = IFCCARTESIANTRANSFORMATIONOPERATOR3D(#51, #52, #50, bad, #53);
#55 = IFCMAPPEDITEM(#41, #54);
#56 = IFCCARTESIANPOINT((300.0, 40.0, 10.0));
#57 = IFCCARTESIANTRANSFORMATIONOPERATOR3DNONUNIFORM(#51, #52, #56, 1.0, #53, 0.0, 1.0);
