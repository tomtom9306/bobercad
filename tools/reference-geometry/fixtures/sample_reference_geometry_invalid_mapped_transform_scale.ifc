#60 = IFCCARTESIANPOINT((10.0, 10.0, 0.0));
#61 = IFCCARTESIANPOINT((20.0, 10.0, 0.0));
#62 = IFCPOLYLINE((#60, #61));
#70 = IFCSHAPEREPRESENTATION($, 'Axis', 'MappedRepresentation', (#55, #58, #62));
#71 = IFCPRODUCTDEFINITIONSHAPE($, $, (#70));
#80 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#81 = IFCDIRECTION((0.0, 0.0, 1.0));
#82 = IFCDIRECTION((1.0, 0.0, 0.0));
#83 = IFCAXIS2PLACEMENT3D(#80, #81, #82);
#84 = IFCLOCALPLACEMENT($, #83);
#90 = IFCBUILDINGELEMENTPROXY('invalid-mapped-scale-ref-1', $, 'Invalid mapped scale reference', $, $, #84, #71, $, $);
