ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD mapped STEP trimmed B-spline reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_mapped_trimmed_bspline_curve.step', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('p1', (0.0, 0.0, 0.0));
#2 = CARTESIAN_POINT('p2', (60.0, 180.0, 0.0));
#3 = CARTESIAN_POINT('p3', (160.0, -140.0, 0.0));
#4 = CARTESIAN_POINT('p4', (240.0, 40.0, 0.0));
#10 = B_SPLINE_CURVE_WITH_KNOTS('', 3, (#1, #2, #3, #4), .UNSPECIFIED., .F., .F., (4, 4), (0.0, 1.0), .UNSPECIFIED.);
#20 = TRIMMED_CURVE('', #10, (PARAMETER_VALUE(0.25)), (PARAMETER_VALUE(0.75)), .T., .PARAMETER.);
#30 = GEOMETRIC_CURVE_SET('', (#20));
#40 = CARTESIAN_POINT('map-origin', (0.0, 0.0, 0.0));
#41 = DIRECTION('map-z', (0.0, 0.0, 1.0));
#42 = DIRECTION('map-x', (1.0, 0.0, 0.0));
#43 = AXIS2_PLACEMENT_3D('', #40, #41, #42);
#50 = SHAPE_REPRESENTATION('', (#30), $);
#51 = REPRESENTATION_MAP(#43, #50);
#60 = CARTESIAN_POINT('target-origin', (500.0, 20.0, 5.0));
#61 = DIRECTION('target-x', (0.0, 1.0, 0.0));
#62 = DIRECTION('target-y', (-1.0, 0.0, 0.0));
#63 = DIRECTION('target-z', (0.0, 0.0, 1.0));
#64 = CARTESIAN_TRANSFORMATION_OPERATOR_3D('', #61, #62, #60, 1.0, #63);
#65 = MAPPED_ITEM(#51, #64);
#66 = SHAPE_REPRESENTATION('', (#65), $);
ENDSEC;
END-ISO-10303-21;
