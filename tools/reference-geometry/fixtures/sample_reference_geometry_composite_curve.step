ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD STEP composite curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_composite_curve.step', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('p1', (0.0, 0.0, 0.0));
#2 = CARTESIAN_POINT('p2', (100.0, 0.0, 0.0));
#3 = CARTESIAN_POINT('p3', (100.0, 50.0, 0.0));
#4 = CARTESIAN_POINT('p4', (100.0, 100.0, 0.0));
#10 = POLYLINE('', (#1, #2));
#11 = POLYLINE('', (#4, #3, #2));
#20 = COMPOSITE_CURVE_SEGMENT(.CONTINUOUS., .T., #10);
#21 = COMPOSITE_CURVE_SEGMENT(.CONTINUOUS., .F., #11);
#30 = COMPOSITE_CURVE('', (#20, #21), .F.);
#40 = GEOMETRIC_CURVE_SET('', (#30));
#50 = SHAPE_REPRESENTATION('', (#40), $);
ENDSEC;
END-ISO-10303-21;
