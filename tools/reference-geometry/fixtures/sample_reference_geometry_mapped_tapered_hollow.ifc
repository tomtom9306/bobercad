ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD mapped tapered hollow IFC reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_mapped_tapered_hollow.ifc', '2026-06-23T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#10 = IFCRECTANGLEHOLLOWPROFILEDEF(.AREA., 'Start hollow', $, 200.0, 100.0, 20.0, 0.0, 0.0);
#11 = IFCRECTANGLEHOLLOWPROFILEDEF(.AREA., 'End hollow', $, 120.0, 60.0, 10.0, 0.0, 0.0);
#12 = IFCDIRECTION((0.0, 0.0, 1.0));
#13 = IFCEXTRUDEDAREASOLIDTAPERED(#10, #4, #12, 150.0, #11);
#30 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#13));
#41 = IFCREPRESENTATIONMAP(#33, #40);
#50 = IFCCARTESIANPOINT((200.0, 30.0, 10.0));
#51 = IFCDIRECTION((1.0, 0.0, 0.0));
#52 = IFCDIRECTION((0.0, 1.0, 0.0));
#53 = IFCDIRECTION((0.0, 0.0, 1.0));
#54 = IFCCARTESIANTRANSFORMATIONOPERATOR3D(#51, #52, #50, 1.0, #53);
#55 = IFCMAPPEDITEM(#41, #54);
#56 = IFCSHAPEREPRESENTATION($, 'Body', 'MappedRepresentation', (#55));
#57 = IFCPRODUCTDEFINITIONSHAPE($, $, (#56));
#60 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#61 = IFCDIRECTION((0.0, 0.0, 1.0));
#62 = IFCDIRECTION((1.0, 0.0, 0.0));
#63 = IFCAXIS2PLACEMENT3D(#60, #61, #62);
#64 = IFCLOCALPLACEMENT($, #63);
#70 = IFCBUILDINGELEMENTPROXY('mapped-tapered-hollow-ref-1', $, 'Mapped tapered hollow reference member', $, $, #64, #57, $, $);
ENDSEC;
