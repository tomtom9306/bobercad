#30 = IFCCARTESIANPOINT((100.0, 200.0, 300.0));
#31 = IFCDIRECTION((1.0, 0.0, 0.0));
#32 = IFCDIRECTION((0.0, 1.0, 0.0));
#33 = IFCDIRECTION((0.0, 0.0, 1.0));
