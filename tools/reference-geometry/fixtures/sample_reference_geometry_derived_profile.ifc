ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC derived profile swept reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_derived_profile.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((10.0, 20.0, 30.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#10 = IFCRECTANGLEPROFILEDEF(.AREA., 'Parent rectangle profile', $, 200.0, 100.0);
#20 = IFCDIRECTION((0.0, 1.0));
#21 = IFCDIRECTION((-1.0, 0.0));
#22 = IFCCARTESIANPOINT((30.0, 40.0));
#23 = IFCCARTESIANTRANSFORMATIONOPERATOR2DNONUNIFORM(#20, #21, #22, 1.0, 2.0);
#24 = IFCDERIVEDPROFILEDEF(.AREA., 'Derived rectangle profile', #10, #23, 'rotated nonuniform profile');
#30 = IFCDIRECTION((0.0, 0.0, 1.0));
#31 = IFCEXTRUDEDAREASOLID(#24, #4, #30, 150.0);
#40 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#31));
#41 = IFCPRODUCTDEFINITIONSHAPE($, $, (#40));
#50 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#51 = IFCDIRECTION((0.0, 0.0, 1.0));
#52 = IFCDIRECTION((1.0, 0.0, 0.0));
#53 = IFCAXIS2PLACEMENT3D(#50, #51, #52);
#54 = IFCLOCALPLACEMENT($, #53);
#60 = IFCBUILDINGELEMENTPROXY('derived-profile-ref-1', $, 'Derived profile reference member', $, $, #54, #41, $, $);
ENDSEC;
END-ISO-10303-21;
