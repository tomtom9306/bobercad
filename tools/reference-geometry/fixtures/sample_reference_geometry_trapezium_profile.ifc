ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC trapezium profile swept reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_trapezium_profile.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((10.0, 20.0, 30.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#10 = IFCTRAPEZIUMPROFILEDEF(.AREA., 'Trapezium profile', $, 260.0, 160.0, 300.0, 20.0);
#11 = IFCDIRECTION((0.0, 0.0, 1.0));
#12 = IFCEXTRUDEDAREASOLID(#10, #4, #11, 200.0);
#20 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#12));
#21 = IFCPRODUCTDEFINITIONSHAPE($, $, (#20));
#30 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#34 = IFCLOCALPLACEMENT($, #33);
#40 = IFCBUILDINGELEMENTPROXY('trapezium-ref-1', $, 'Trapezium profile reference member', $, $, #34, #21, $, $);
ENDSEC;
END-ISO-10303-21;
