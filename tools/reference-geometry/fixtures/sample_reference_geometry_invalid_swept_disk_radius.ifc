FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((100.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((100.0, 60.0, 0.0));
#10 = IFCPOLYLINE((#1, #2, #3));
#20 = IFCSWEPTDISKSOLID(#10, 10.0, $, $, $);
#101 = IFCCARTESIANPOINT((400.0, 0.0, 0.0));
#102 = IFCCARTESIANPOINT((500.0, 0.0, 0.0));
#103 = IFCCARTESIANPOINT((500.0, 60.0, 0.0));
#110 = IFCPOLYLINE((#101, #102, #103));
#120 = IFCSWEPTDISKSOLID(#110, BAD_VALUE, $, 50.0, 130.0);
#201 = IFCCARTESIANPOINT((800.0, 0.0, 0.0));
#202 = IFCCARTESIANPOINT((900.0, 0.0, 0.0));
#203 = IFCCARTESIANPOINT((900.0, 60.0, 0.0));
#210 = IFCPOLYLINE((#201, #202, #203));
#220 = IFCSWEPTDISKSOLID(#210, 10.0, BAD_VALUE, $, $);
#230 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#20, #120, #220));
#231 = IFCPRODUCTDEFINITIONSHAPE($, $, (#230));
#240 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#241 = IFCDIRECTION((0.0, 0.0, 1.0));
#242 = IFCDIRECTION((1.0, 0.0, 0.0));
#243 = IFCAXIS2PLACEMENT3D(#240, #241, #242);
#244 = IFCLOCALPLACEMENT($, #243);
#250 = IFCBUILDINGELEMENTPROXY('invalid-swept-disk-radius-ref-1', $, 'Invalid swept disk radius reference member', $, $, #244, #231, $, $);
ENDSEC;
