ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD styled STEP reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_styled.step', '2026-06-26T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('red-origin', (0.0, 0.0, 0.0));
#2 = DIRECTION('z-axis', (0.0, 0.0, 1.0));
#3 = DIRECTION('x-axis', (1.0, 0.0, 0.0));
#4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
#5 = CARTESIAN_POINT('blue-origin', (80.0, 0.0, 0.0));
#6 = AXIS2_PLACEMENT_3D('', #5, #2, #3);
#10 = RECTANGLE_PROFILE_DEF('styled-plate-profile', $, 20.0, 10.0);
#11 = DIRECTION('extrude-z', (0.0, 0.0, 1.0));
#12 = EXTRUDED_AREA_SOLID('red-solid', #10, #4, #11, 5.0);
#13 = EXTRUDED_AREA_SOLID('blue-solid', #10, #6, #11, 5.0);
#20 = SHAPE_REPRESENTATION('', (#12, #13), $);
#40 = COLOUR_RGB('Red', 1.0, 0.0, 0.0);
#41 = SURFACE_STYLE_RENDERING(#40, 0.6, $, $, $, $, $, $, .NOTDEFINED.);
#42 = SURFACE_SIDE_STYLE('Red surface', (#41));
#43 = SURFACE_STYLE_USAGE(.BOTH., #42);
#44 = PRESENTATION_STYLE_ASSIGNMENT((#43));
#45 = STYLED_ITEM('Red style', (#44), #12);
#50 = COLOUR_RGB('Blue', 0.0, 0.2, 1.0);
#51 = SURFACE_STYLE_RENDERING(#50, 0.0, $, $, $, $, $, $, .NOTDEFINED.);
#52 = SURFACE_SIDE_STYLE('Blue surface', (#51));
#53 = SURFACE_STYLE_USAGE(.BOTH., #52);
#54 = PRESENTATION_STYLE_ASSIGNMENT((#53));
#55 = STYLED_ITEM('Blue style', (#54), #13);
ENDSEC;
