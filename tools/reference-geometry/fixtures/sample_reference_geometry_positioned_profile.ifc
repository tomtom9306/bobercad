ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC positioned profile swept reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_positioned_profile.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((10.0, 20.0, 30.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#10 = IFCCARTESIANPOINT((30.0, 40.0));
#11 = IFCDIRECTION((0.0, 1.0));
#12 = IFCAXIS2PLACEMENT2D(#10, #11);
#20 = IFCRECTANGLEPROFILEDEF(.AREA., 'Positioned rectangle profile', #12, 200.0, 100.0);
#21 = IFCDIRECTION((0.0, 0.0, 1.0));
#22 = IFCEXTRUDEDAREASOLID(#20, #4, #21, 150.0);
#30 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#22));
#31 = IFCPRODUCTDEFINITIONSHAPE($, $, (#30));
#40 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#41 = IFCDIRECTION((0.0, 0.0, 1.0));
#42 = IFCDIRECTION((1.0, 0.0, 0.0));
#43 = IFCAXIS2PLACEMENT3D(#40, #41, #42);
#44 = IFCLOCALPLACEMENT($, #43);
#50 = IFCBUILDINGELEMENTPROXY('positioned-profile-ref-1', $, 'Positioned profile reference member', $, $, #44, #31, $, $);
ENDSEC;
END-ISO-10303-21;
