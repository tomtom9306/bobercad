ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('sample_reference_geometry_styled_vertex_points.ifc','2026-06-28T00:00:00',('Codex'),('OpenAI'),'','','');
