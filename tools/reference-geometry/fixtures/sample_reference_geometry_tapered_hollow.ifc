ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC tapered hollow reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_tapered_hollow.ifc', '2026-06-23T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((10.0, 20.0, 30.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#10 = IFCRECTANGLEHOLLOWPROFILEDEF(.AREA., 'Start hollow', $, 200.0, 100.0, 20.0, 0.0, 0.0);
#11 = IFCRECTANGLEHOLLOWPROFILEDEF(.AREA., 'End hollow', $, 120.0, 60.0, 10.0, 0.0, 0.0);
#12 = IFCDIRECTION((0.0, 0.0, 1.0));
#13 = IFCEXTRUDEDAREASOLIDTAPERED(#10, #4, #12, 150.0, #11);
#20 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#13));
#21 = IFCPRODUCTDEFINITIONSHAPE($, $, (#20));
#30 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#34 = IFCLOCALPLACEMENT($, #33);
#40 = IFCBUILDINGELEMENTPROXY('tapered-hollow-ref-1', $, 'Tapered hollow reference member', $, $, #34, #21, $, $);
ENDSEC;
END-ISO-10303-21;
