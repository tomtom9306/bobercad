ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD mapped IFC trimmed B-spline reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_mapped_trimmed_bspline_curve.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((60.0, 180.0, 0.0));
#3 = IFCCARTESIANPOINT((160.0, -140.0, 0.0));
#4 = IFCCARTESIANPOINT((240.0, 40.0, 0.0));
#10 = IFCBSPLINECURVEWITHKNOTS(3, (#1, #2, #3, #4), .UNSPECIFIED., .F., .F., (4, 4), (0.0, 1.0), .UNSPECIFIED.);
#20 = IFCTRIMMEDCURVE(#10, (IFCPARAMETERVALUE(0.25)), (IFCPARAMETERVALUE(0.75)), .T., .PARAMETER.);
#30 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#20));
#41 = IFCREPRESENTATIONMAP(#33, #40);
#50 = IFCCARTESIANPOINT((200.0, 30.0, 10.0));
#51 = IFCDIRECTION((0.0, 1.0, 0.0));
#52 = IFCDIRECTION((-1.0, 0.0, 0.0));
#53 = IFCDIRECTION((0.0, 0.0, 1.0));
#54 = IFCCARTESIANTRANSFORMATIONOPERATOR3D(#51, #52, #50, 1.0, #53);
#55 = IFCMAPPEDITEM(#41, #54);
#60 = IFCSHAPEREPRESENTATION($, 'Axis', 'MappedRepresentation', (#55));
#61 = IFCPRODUCTDEFINITIONSHAPE($, $, (#60));
#70 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#71 = IFCDIRECTION((0.0, 0.0, 1.0));
#72 = IFCDIRECTION((1.0, 0.0, 0.0));
#73 = IFCAXIS2PLACEMENT3D(#70, #71, #72);
#74 = IFCLOCALPLACEMENT($, #73);
#80 = IFCBUILDINGELEMENTPROXY('mapped-trimmed-bspline-ref-1', $, 'Mapped trimmed B-spline reference', $, $, #74, #61, $, $);
ENDSEC;
END-ISO-10303-21;
