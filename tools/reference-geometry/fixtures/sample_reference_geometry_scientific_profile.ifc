ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC scientific profile reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_scientific_profile.ifc', '2026-06-23T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCDIRECTION((1.0, 0.0, 0.0));
#3 = IFCDIRECTION((0.0, 0.0, 1.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #3, #2);
#5 = IFCLOCALPLACEMENT($, #4);
#10 = IFCCARTESIANPOINT((0.0, 0.0));
#11 = IFCCARTESIANPOINT((85.0, -2.27373675443232E-12));
#12 = IFCCARTESIANPOINT((85.0, 105.0));
#13 = IFCCARTESIANPOINT((2.67391442321241E-10, 105.0));
#14 = IFCPOLYLINE((#10, #11, #12, #13, #10));
#15 = IFCARBITRARYCLOSEDPROFILEDEF(.AREA., 'Scientific profile', #14);
#16 = IFCAXIS2PLACEMENT3D(#1, #3, #2);
#17 = IFCEXTRUDEDAREASOLID(#15, #16, #3, 10.0);
#18 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#17));
#19 = IFCPRODUCTDEFINITIONSHAPE($, $, (#18));
#20 = IFCDISCRETEACCESSORY('scientific-profile-guid', $, 'Scientific profile', $, $, #5, #19, $);
ENDSEC;
END-ISO-10303-21;
