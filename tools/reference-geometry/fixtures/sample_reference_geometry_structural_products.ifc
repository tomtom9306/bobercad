ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC structural product placement reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_structural_products.ifc', '2026-06-28T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCDIRECTION((1.0, 0.0, 0.0));
#3 = IFCDIRECTION((0.0, 0.0, 1.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #3, #2);
#10 = IFCRECTANGLEPROFILEDEF(.AREA., 'Foundation plate', $, 100.0, 40.0);
#11 = IFCEXTRUDEDAREASOLID(#10, #4, #3, 20.0);
#12 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#11));
#13 = IFCPRODUCTDEFINITIONSHAPE($, $, (#12));
#20 = IFCCARTESIANPOINT((500.0, 100.0, 20.0));
#21 = IFCAXIS2PLACEMENT3D(#20, #3, #2);
#22 = IFCLOCALPLACEMENT($, #21);
#23 = IFCFOOTING('footing-guid', $, 'Footing', $, $, #22, #13, $);
#30 = IFCCARTESIANPOINT((-200.0, 300.0, 50.0));
#31 = IFCAXIS2PLACEMENT3D(#30, #3, #2);
#32 = IFCLOCALPLACEMENT($, #31);
#33 = IFCPILE('pile-guid', $, 'Pile', $, $, #32, #13, $);
ENDSEC;
END-ISO-10303-21;
