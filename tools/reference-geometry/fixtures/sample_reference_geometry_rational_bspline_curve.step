FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('p1', (100.0, 0.0, 0.0));
#2 = CARTESIAN_POINT('p2', (100.0, 100.0, 0.0));
#3 = CARTESIAN_POINT('p3', (0.0, 100.0, 0.0));
#10 = (BOUNDED_CURVE() B_SPLINE_CURVE(2, (#1, #2, #3), .CIRCULAR_ARC., .F., .F.) B_SPLINE_CURVE_WITH_KNOTS((3, 3), (0.0, 1.0), .UNSPECIFIED.) CURVE() GEOMETRIC_REPRESENTATION_ITEM() RATIONAL_B_SPLINE_CURVE((1.0, 0.7071067811865476, 1.0)) REPRESENTATION_ITEM(''));
#20 = GEOMETRIC_CURVE_SET('', (#10));
#30 = SHAPE_REPRESENTATION('', (#20), $);
ENDSEC;
