ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD STEP Cartesian trimmed curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_trimmed_curve_cartesian.step', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('center', (250.0, 100.0, 20.0));
#2 = DIRECTION('z', (0.0, 0.0, 1.0));
#3 = DIRECTION('x', (0.0, 1.0, 0.0));
#4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
#10 = CIRCLE('', #4, 40.0);
#11 = ELLIPSE('', #4, 60.0, 25.0);
#101 = CARTESIAN_POINT('circle-start', (250.0, 140.0, 20.0));
#102 = CARTESIAN_POINT('circle-end', (210.0, 100.0, 20.0));
#103 = CARTESIAN_POINT('ellipse-start', (225.0, 100.0, 20.0));
#104 = CARTESIAN_POINT('ellipse-end', (250.0, 40.0, 20.0));
#20 = TRIMMED_CURVE('', #10, (#101), (#102), .T., .CARTESIAN.);
#21 = TRIMMED_CURVE('', #11, (#103), (#104), .T., .CARTESIAN.);
#30 = GEOMETRIC_CURVE_SET('', (#20, #21));
#40 = SHAPE_REPRESENTATION('', (#30), $);
ENDSEC;
END-ISO-10303-21;
