ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD styled IFC reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_styled.ifc', '2026-06-23T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#5 = IFCLOCALPLACEMENT($, #4);
#6 = IFCCARTESIANPOINT((80.0, 0.0, 0.0));
#7 = IFCAXIS2PLACEMENT3D(#6, #2, #3);
#8 = IFCLOCALPLACEMENT($, #7);
#10 = IFCRECTANGLEPROFILEDEF(.AREA., 'Styled plate profile', $, 20.0, 10.0);
#11 = IFCEXTRUDEDAREASOLID(#10, #4, #2, 5.0);
#12 = IFCEXTRUDEDAREASOLID(#10, #4, #2, 5.0);
#20 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#11));
#21 = IFCPRODUCTDEFINITIONSHAPE($, $, (#20));
#22 = IFCBUILDINGELEMENTPROXY('styled-red', $, 'Styled red plate', $, $, #5, #21, $, $);
#30 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#12));
#31 = IFCPRODUCTDEFINITIONSHAPE($, $, (#30));
#32 = IFCBUILDINGELEMENTPROXY('styled-blue', $, 'Styled blue plate', $, $, #8, #31, $, $);
#40 = IFCCOLOURRGB('Red', 1.0, 0.0, 0.0);
#41 = IFCSURFACESTYLERENDERING(#40, 0.6, $, $, $, $, IFCNORMALISEDRATIOMEASURE(0.00390625), IFCSPECULAREXPONENT(10.0), .NOTDEFINED.);
#42 = IFCSURFACESTYLE('Red steel', .POSITIVE., (#41));
#43 = IFCPRESENTATIONSTYLEASSIGNMENT((#42));
#44 = IFCSTYLEDITEM(#11, (#43), $);
#50 = IFCCOLOURRGB('Blue', 0.0, 0.2, 1.0);
#51 = IFCSURFACESTYLERENDERING(#50, 0.0, $, $, $, $, IFCNORMALISEDRATIOMEASURE(0.00390625), IFCSPECULAREXPONENT(10.0), .NOTDEFINED.);
#52 = IFCSURFACESTYLE('Blue steel', .POSITIVE., (#51));
#53 = IFCPRESENTATIONSTYLEASSIGNMENT((#52));
#54 = IFCSTYLEDITEM(#12, (#53), $);
ENDSEC;
