ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC trimmed B-spline curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_trimmed_bspline_curve.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((60.0, 180.0, 0.0));
#3 = IFCCARTESIANPOINT((160.0, -140.0, 0.0));
#4 = IFCCARTESIANPOINT((240.0, 40.0, 0.0));
#10 = IFCBSPLINECURVEWITHKNOTS(3, (#1, #2, #3, #4), .UNSPECIFIED., .F., .F., (4, 4), (0.0, 1.0), .UNSPECIFIED.);
#20 = IFCTRIMMEDCURVE(#10, (IFCPARAMETERVALUE(0.25)), (IFCPARAMETERVALUE(0.75)), .T., .PARAMETER.);
#30 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#34 = IFCLOCALPLACEMENT($, #33);
#40 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#20));
#41 = IFCPRODUCTDEFINITIONSHAPE($, $, (#40));
#50 = IFCBUILDINGELEMENTPROXY('trimmed-bspline-curve-ref-1', $, 'Trimmed B-spline curve reference', $, $, #34, #41, $, $);
ENDSEC;
END-ISO-10303-21;
