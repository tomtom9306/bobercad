ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD metre-unit IFC reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_units.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((1.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((1.0, 1.0, 0.0));
#4 = IFCCARTESIANPOINT((0.0, 1.0, 0.0));
#20 = IFCPOLYLOOP((#1, #2, #3, #4));
#30 = IFCFACEOUTERBOUND(#20, .T.);
#40 = IFCFACE((#30));
#50 = IFCCLOSEDSHELL((#40));
#51 = IFCFACETEDBREP(#50);
#90 = IFCSIUNIT($, .LENGTHUNIT., $, .METRE.);
ENDSEC;
END-ISO-10303-21;
