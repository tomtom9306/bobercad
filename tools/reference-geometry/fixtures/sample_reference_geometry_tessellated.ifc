ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC triangulated tessellated reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_tessellated.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#10 = IFCCARTESIANPOINTLIST3D((
  (0.0, 0.0, 0.0),
  (300.0, 0.0, 0.0),
  (300.0, 180.0, 0.0),
  (0.0, 180.0, 0.0),
  (0.0, 0.0, 140.0),
  (300.0, 0.0, 140.0),
  (300.0, 180.0, 140.0),
  (0.0, 180.0, 140.0)
));
#20 = IFCTRIANGULATEDFACESET(#10, .T., (
  (1, 2, 3),
  (1, 3, 4),
  (5, 8, 7),
  (5, 7, 6),
  (1, 5, 6),
  (1, 6, 2),
  (2, 6, 7),
  (2, 7, 3),
  (3, 7, 8),
  (3, 8, 4),
  (4, 8, 5),
  (4, 5, 1)
), $, $);
#30 = IFCSHAPEREPRESENTATION($, 'Body', 'Tessellation', (#20));
#31 = IFCPRODUCTDEFINITIONSHAPE($, $, (#30));
#40 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#41 = IFCDIRECTION((0.0, 0.0, 1.0));
#42 = IFCDIRECTION((1.0, 0.0, 0.0));
#43 = IFCAXIS2PLACEMENT3D(#40, #41, #42);
#44 = IFCLOCALPLACEMENT($, #43);
#50 = IFCBUILDINGELEMENTPROXY('tessellated-ref-1', $, 'Tessellated reference block', $, $, #44, #31, $, $);
ENDSEC;
END-ISO-10303-21;
