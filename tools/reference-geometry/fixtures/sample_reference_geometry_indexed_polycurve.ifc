ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD indexed polycurve IFC reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_indexed_polycurve.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINTLIST3D(((0.0, 0.0, 0.0), (100.0, 0.0, 0.0), (100.0, 50.0, 0.0), (150.0, 50.0, 20.0)));
#2 = IFCLINEINDEX((1, 2, 3, 4));
#3 = IFCINDEXEDPOLYCURVE(#1, (#2), .F.);
#10 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#11 = IFCDIRECTION((0.0, 0.0, 1.0));
#12 = IFCDIRECTION((0.0, 1.0, 0.0));
#13 = IFCLOCALPLACEMENT($, #14);
#14 = IFCAXIS2PLACEMENT3D(#10, #11, #12);
#20 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#3));
#21 = IFCPRODUCTDEFINITIONSHAPE($, $, (#20));
#30 = IFCBUILDINGELEMENTPROXY('indexed-polycurve-ref-1', $, 'Indexed polycurve reference', $, $, #13, #21, $, $);
ENDSEC;
END-ISO-10303-21;
