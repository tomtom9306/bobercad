ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD STEP trimmed curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_trimmed_curve.step', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('center', (250.0, 100.0, 20.0));
#2 = DIRECTION('z', (0.0, 0.0, 1.0));
#3 = DIRECTION('x', (0.0, 1.0, 0.0));
#4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
#10 = CIRCLE('', #4, 40.0);
#11 = ELLIPSE('', #4, 60.0, 25.0);
#20 = TRIMMED_CURVE('', #10, (PARAMETER_VALUE(0.0)), (PARAMETER_VALUE(1.5707963267948966)), .T., .PARAMETER.);
#21 = TRIMMED_CURVE('', #11, (PARAMETER_VALUE(1.5707963267948966)), (PARAMETER_VALUE(3.141592653589793)), .T., .PARAMETER.);
#30 = GEOMETRIC_CURVE_SET('', (#20, #21));
#40 = SHAPE_REPRESENTATION('', (#30), $);
ENDSEC;
END-ISO-10303-21;
