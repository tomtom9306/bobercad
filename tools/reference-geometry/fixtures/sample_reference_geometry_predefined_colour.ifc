ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD predefined colour IFC reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_predefined_colour.ifc', '2026-06-28T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCDIRECTION((0.0, 0.0, 1.0));
#3 = IFCDIRECTION((1.0, 0.0, 0.0));
#4 = IFCAXIS2PLACEMENT3D(#1, #2, #3);
#5 = IFCLOCALPLACEMENT($, #4);
#10 = IFCRECTANGLEPROFILEDEF(.AREA., 'Predefined colour profile', $, 20.0, 10.0);
#11 = IFCEXTRUDEDAREASOLID(#10, #4, #2, 5.0);
#20 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#11));
#21 = IFCPRODUCTDEFINITIONSHAPE($, $, (#20));
#22 = IFCBUILDINGELEMENTPROXY('predefined-cyan', $, 'Predefined cyan plate', $, $, #5, #21, $, $);
#40 = IFCDRAUGHTINGPREDEFINEDCOLOUR('cyan');
#41 = IFCSURFACESTYLERENDERING(#40, 0.0, $, $, $, $, IFCNORMALISEDRATIOMEASURE(0.00390625), IFCSPECULAREXPONENT(10.0), .NOTDEFINED.);
#42 = IFCSURFACESTYLE('Cyan predefined steel', .POSITIVE., (#41));
#43 = IFCPRESENTATIONSTYLEASSIGNMENT((#42));
#44 = IFCSTYLEDITEM(#11, (#43), $);
ENDSEC;
END-ISO-10303-21;
