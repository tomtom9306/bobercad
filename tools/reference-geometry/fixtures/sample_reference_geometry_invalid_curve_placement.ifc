ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC invalid curve placement reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_invalid_curve_placement.ifc', '2026-06-29T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((200.0, 50.0));
#2 = IFCDIRECTION((0.0, 1.0));
#3 = IFCAXIS2PLACEMENT2D(#1, #2);
#4 = IFCCIRCLE(#3, 40.0);
#5 = IFCCARTESIANPOINT((300.0, bad));
#6 = IFCAXIS2PLACEMENT2D(#5, #2);
#7 = IFCCIRCLE(#6, 40.0);
#10 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#11 = IFCDIRECTION((0.0, 0.0, 1.0));
#12 = IFCDIRECTION((0.0, 1.0, 0.0));
#13 = IFCLOCALPLACEMENT($, #14);
#14 = IFCAXIS2PLACEMENT3D(#10, #11, #12);
#20 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve2D', (#4, #7));
#21 = IFCPRODUCTDEFINITIONSHAPE($, $, (#20));
#30 = IFCBUILDINGELEMENTPROXY('invalid-curve-placement-ref-1', $, 'Invalid curve placement reference', $, $, #13, #21, $, $);
ENDSEC;
