ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD mapped non-uniform IFC curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_mapped_curve_non_uniform.ifc', '2026-06-23T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((10.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((10.0, 20.0, 0.0));
#10 = IFCPOLYLINE((#1, #2, #3));
#30 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#31 = IFCDIRECTION((0.0, 0.0, 1.0));
#32 = IFCDIRECTION((1.0, 0.0, 0.0));
#33 = IFCAXIS2PLACEMENT3D(#30, #31, #32);
#40 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#10));
#41 = IFCREPRESENTATIONMAP(#33, #40);
#50 = IFCCARTESIANPOINT((100.0, 200.0, 300.0));
#51 = IFCDIRECTION((1.0, 0.0, 0.0));
#52 = IFCDIRECTION((0.0, 1.0, 0.0));
#53 = IFCDIRECTION((0.0, 0.0, 1.0));
#54 = IFCCARTESIANTRANSFORMATIONOPERATOR3DNONUNIFORM(#51, #52, #50, 2.0, #53, 3.0, 4.0);
#55 = IFCMAPPEDITEM(#41, #54);
#60 = IFCSHAPEREPRESENTATION($, 'Axis', 'MappedRepresentation', (#55));
#61 = IFCPRODUCTDEFINITIONSHAPE($, $, (#60));
#70 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#71 = IFCDIRECTION((0.0, 0.0, 1.0));
#72 = IFCDIRECTION((1.0, 0.0, 0.0));
#73 = IFCAXIS2PLACEMENT3D(#70, #71, #72);
#74 = IFCLOCALPLACEMENT($, #73);
#80 = IFCBUILDINGELEMENTPROXY('mapped-curve-non-uniform-ref-1', $, 'Mapped non-uniform curve reference', $, $, #74, #61, $, $);
ENDSEC;
END-ISO-10303-21;
