ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD IFC B-spline curve reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_bspline_curve.ifc', '2026-06-22T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((60.0, 180.0, 0.0));
#3 = IFCCARTESIANPOINT((160.0, -140.0, 0.0));
#4 = IFCCARTESIANPOINT((240.0, 40.0, 0.0));
#10 = IFCBSPLINECURVEWITHKNOTS(3, (#1, #2, #3, #4), .UNSPECIFIED., .F., .F., (4, 4), (0.0, 1.0), .UNSPECIFIED.);
#20 = IFCCARTESIANPOINT((1000.0, 500.0, 20.0));
#21 = IFCDIRECTION((0.0, 0.0, 1.0));
#22 = IFCDIRECTION((1.0, 0.0, 0.0));
#23 = IFCAXIS2PLACEMENT3D(#20, #21, #22);
#24 = IFCLOCALPLACEMENT($, #23);
#30 = IFCSHAPEREPRESENTATION($, 'Axis', 'Curve3D', (#10));
#31 = IFCPRODUCTDEFINITIONSHAPE($, $, (#30));
#40 = IFCBUILDINGELEMENTPROXY('bspline-curve-ref-1', $, 'B-spline curve reference', $, $, #24, #31, $, $);
ENDSEC;
END-ISO-10303-21;
