ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD STEP invalid swept disk parameter reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_invalid_swept_disk_parameters.step', '2026-06-29T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = CARTESIAN_POINT('valid-p0', (0.0, 0.0, 0.0));
#2 = CARTESIAN_POINT('valid-p1', (100.0, 0.0, 0.0));
#3 = CARTESIAN_POINT('valid-p2', (100.0, 60.0, 0.0));
#10 = POLYLINE('', (#1, #2, #3));
#20 = SWEPT_DISK_SOLID('', #10, 10.0, $, $, $);
#101 = CARTESIAN_POINT('invalid-p0', (400.0, 0.0, 0.0));
#102 = CARTESIAN_POINT('invalid-p1', (500.0, 0.0, 0.0));
#103 = CARTESIAN_POINT('invalid-p2', (500.0, 60.0, 0.0));
#110 = POLYLINE('', (#101, #102, #103));
#120 = SWEPT_DISK_SOLID('', #110, 10.0, $, BAD_VALUE, 130.0);
#130 = SHAPE_REPRESENTATION('', (#20, #120), $);
ENDSEC;
END-ISO-10303-21;
