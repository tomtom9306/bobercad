#107 = CARTESIAN_POINT('inner3', (160.0, 120.0, 0.0));
#108 = CARTESIAN_POINT('inner4', (80.0, 120.0, 0.0));
#20 = POLYLINE('', (#101, #102, #103, #104));
#21 = POLYLINE('', (#105, #106, #107, #108));
