ENDSEC;
DATA;
#1 = CARTESIAN_POINT('solid-origin', (0.0, 0.0, 0.0));
#2 = DIRECTION('solid-z', (0.0, 0.0, 1.0));
#3 = DIRECTION('solid-x', (1.0, 0.0, 0.0));
