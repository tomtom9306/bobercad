#101 = CARTESIAN_POINT('outer1', (0.0, 0.0, 0.0));
#102 = CARTESIAN_POINT('outer2', (240.0, 0.0, 0.0));
#103 = CARTESIAN_POINT('outer3', (240.0, 180.0, 0.0));
#104 = CARTESIAN_POINT('outer4', (0.0, 180.0, 0.0));
#105 = CARTESIAN_POINT('inner1', (80.0, 60.0, 0.0));
