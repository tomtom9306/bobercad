ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BoberCAD foot-unit IFC reference fixture'), '2;1');
FILE_NAME('sample_reference_geometry_units_foot.ifc', '2026-06-23T00:00:00', ('BoberCAD'), ('BoberCAD'), 'BoberCAD', 'BoberCAD', '');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#2 = IFCCARTESIANPOINT((1.0, 0.0, 0.0));
#3 = IFCCARTESIANPOINT((1.0, 1.0, 0.0));
#4 = IFCCARTESIANPOINT((0.0, 1.0, 0.0));
#20 = IFCPOLYLOOP((#1, #2, #3, #4));
#30 = IFCFACEOUTERBOUND(#20, .T.);
#40 = IFCFACE((#30));
#50 = IFCCLOSEDSHELL((#40));
#51 = IFCFACETEDBREP(#50);
#90 = IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(0.3048), #91);
#91 = IFCSIUNIT($, .LENGTHUNIT., $, .METRE.);
#92 = IFCCONVERSIONBASEDUNIT($, .LENGTHUNIT., 'FOOT', #90);
ENDSEC;
END-ISO-10303-21;
