#10 = IFCCARTESIANPOINT((100.0, 0.0));
#11 = IFCDIRECTION((1.0, 0.0));
#12 = IFCAXIS2PLACEMENT2D(#10, #11);
#20 = IFCRECTANGLEPROFILEDEF(.AREA., 'Revolved rectangle', #12, 40.0, 80.0);
#30 = IFCCARTESIANPOINT((0.0, 0.0, 0.0));
#31 = IFCDIRECTION((0.0, 1.0, 0.0));
#32 = IFCAXIS1PLACEMENT(#30, #31);
#40 = IFCREVOLVEDAREASOLID(#20, #4, #32, 6.283185307179586);
#50 = IFCDIRECTION((0.0, 0.0, 0.0));
#51 = IFCAXIS1PLACEMENT(#30, #50);
#52 = IFCREVOLVEDAREASOLID(#20, #4, #51, 6.283185307179586);
#60 = IFCDIRECTION((0.0, BAD_VALUE, 0.0));
#61 = IFCAXIS1PLACEMENT(#30, #60);
#62 = IFCREVOLVEDAREASOLID(#20, #4, #61, 6.283185307179586);
#70 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#40, #52, #62));
