{
  "$schema": "../../bobercad/app/schemas/reference-geometry-adapters.schema.json",
  "schema": "bobercad-reference-geometry-adapters",
  "schemaVersion": "0.1.0",
  "adapters": {
    "dwg": {
      "formats": [
        "dxf",
        "dwg"
      ],
      "command": "node",
      "args": [
        "adapters/dwg_to_dxf_bridge_adapter.mjs",
        "--request",
        "{request}"
      ],
      "env": {
        "BOBERCAD_DWG_TO_DXF_COMMAND": "path/to/dwg-to-dxf-converter",
        "BOBERCAD_DWG_TO_DXF_OUTPUT": "{scratchDir}/{sourceFileStem}.converted.dxf",
        "BOBERCAD_DWG_TO_DXF_ARG_0": "--input",
        "BOBERCAD_DWG_TO_DXF_ARG_1": "{input}",
        "BOBERCAD_DWG_TO_DXF_ARG_2": "--output",
        "BOBERCAD_DWG_TO_DXF_ARG_3": "{scratchDir}/{sourceFileStem}.converted.dxf",
        "BOBERCAD_DWG_TO_DXF_STREAM_MAX_BUFFER_BYTES": "67108864",
        "BOBERCAD_REFERENCE_ADAPTER_FORMAT": "{format}",
        "BOBERCAD_REFERENCE_ADAPTER_REQUESTED_FORMAT": "{requestedFormat}",
        "BOBERCAD_REFERENCE_ADAPTER_KEY": "{adapterKey}",
        "BOBERCAD_REFERENCE_ADAPTER_RUN_ID": "{adapterRunId}",
        "BOBERCAD_REFERENCE_ADAPTER_REQUEST_PATH": "{request}",
        "BOBERCAD_REFERENCE_ADAPTER_CONFIG_PATH": "{adapterConfigPath}",
        "BOBERCAD_REFERENCE_ADAPTER_CONFIG_DIR": "{adapterConfigDir}",
        "BOBERCAD_REFERENCE_ADAPTER_CONFIG_SIZE_BYTES": "{adapterConfigFileSizeBytes}",
        "BOBERCAD_REFERENCE_ADAPTER_CONFIG_MTIME": "{adapterConfigFileModifiedTime}",
        "BOBERCAD_REFERENCE_ADAPTER_REGISTRY_FINGERPRINT": "{adapterRegistryFingerprint}",
        "BOBERCAD_REFERENCE_ADAPTER_REGISTRY_ADAPTER_FINGERPRINT": "{adapterRegistryAdapterFingerprint}",
        "BOBERCAD_REFERENCE_ADAPTER_STAGE_DIR": "{stageDir}",
        "BOBERCAD_REFERENCE_ADAPTER_SCRATCH_DIR": "{scratchDir}",
        "BOBERCAD_REFERENCE_ADAPTER_CHUNK_DIR": "{chunkDir}",
        "BOBERCAD_REFERENCE_ADAPTER_CHUNK_PATH_PREFIX": "{chunkPathPrefix}",
        "BOBERCAD_REFERENCE_ADAPTER_OUTPUT_MODE": "{outputMode}",
        "BOBERCAD_REFERENCE_ADAPTER_POINT_CLOUD_CHUNK_SIZE": "{pointCloudChunkSize}",
        "BOBERCAD_REFERENCE_ADAPTER_TIMEOUT_MS": "{timeoutMs}",
        "BOBERCAD_REFERENCE_ADAPTER_LOG_PATH": "{adapterLogPath}",
        "BOBERCAD_REFERENCE_ADAPTER_STDOUT_PATH": "{adapterStdoutPath}",
        "BOBERCAD_REFERENCE_ADAPTER_STDERR_PATH": "{adapterStderrPath}",
        "BOBERCAD_REFERENCE_ADAPTER_OUTPUT_FILE": "{outputFileName}",
        "BOBERCAD_REFERENCE_ADAPTER_OUTPUT_STEM": "{outputFileStem}",
        "BOBERCAD_REFERENCE_ADAPTER_SOURCE_DIR": "{sourceDirectory}",
        "BOBERCAD_REFERENCE_ADAPTER_SOURCE_FILE": "{sourceFileName}",
        "BOBERCAD_REFERENCE_ADAPTER_SOURCE_STEM": "{sourceFileStem}",
        "BOBERCAD_REFERENCE_ADAPTER_SOURCE_EXTENSION": "{sourceFileExtension}",
        "BOBERCAD_REFERENCE_ADAPTER_SOURCE_SIZE_BYTES": "{sourceFileSizeBytes}",
        "BOBERCAD_REFERENCE_ADAPTER_SOURCE_MTIME": "{sourceFileModifiedTime}",
        "BOBERCAD_REFERENCE_ADAPTER_SOURCE_STAT_FINGERPRINT": "{sourceStatFingerprint}",
        "BOBERCAD_REFERENCE_ADAPTER_REQUEST_SCHEMA_PATH": "{adapterRequestSchemaPath}",
        "BOBERCAD_REFERENCE_ADAPTER_REFERENCE_SCHEMA_PATH": "{referenceGeometrySchemaPath}",
        "BOBERCAD_REFERENCE_ADAPTER_CHUNK_SCHEMA_PATH": "{pointCloudChunkSchemaPath}",
        "BOBERCAD_REFERENCE_ADAPTER_SCHEMA_VERSION": "{adapterRequestSchemaVersion}",
        "BOBERCAD_REFERENCE_ADAPTER_REFERENCE_SCHEMA_VERSION": "{referenceGeometrySchemaVersion}",
        "BOBERCAD_REFERENCE_ADAPTER_CHUNK_SCHEMA_VERSION": "{pointCloudChunkSchemaVersion}"
      },
      "requiredFiles": [
        "adapters/dwg_to_dxf_bridge_adapter.mjs",
        "adapters/adapter_request_contract.mjs",
        "adapters/adapter_output_contract.mjs",
        "adapters/validate_adapter_request.mjs",
        "adapters/validate_adapter_output.mjs",
        "translate_reference_geometry.mjs"
      ],
      "requiredCommands": [
        "path/to/dwg-to-dxf-converter"
      ],
      "timeoutMs": 120000,
      "description": "Example DXF/DWG bridge. DXF inputs are translated with the built-in DXF canonical translator; DWG inputs first run the local converter from BOBERCAD_DWG_TO_DXF_COMMAND, then translate the staged DXF into canonical JSON."
    },
    "step": {
