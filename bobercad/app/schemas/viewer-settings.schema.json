{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/viewer-settings.schema.json",
  "title": "Steel BIM Viewer Settings Schema",
  "description": "Schema for viewer-only settings such as camera, UI, controls, and render preferences.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "project",
    "camera",
    "controls",
    "render",
    "ui"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "steel-bim-viewer-settings"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "demos": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": [
        "home",
        "fit"
      ],
      "properties": {
        "home": {
          "type": "object",
          "required": [
            "yaw",
            "pitch",
            "scale",
            "pan"
          ],
          "properties": {
            "yaw": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pan": {
              "$ref": "#/$defs/vec2"
            }
          },
          "additionalProperties": false
        },
        "fit": {
          "type": "object",
          "required": [
            "padding",
            "minDepthHalf"
          ],
          "properties": {
            "padding": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minDepthHalf": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "orbitSpeed",
        "panSpeed",
        "zoomInFactor",
        "zoomOutFactor"
      ],
      "properties": {
        "orbitSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "panSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "zoomInFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "zoomOutFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/shortcutBinding"
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/shortcutBinding"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/shortcutBinding"
              }
            }
          }
        ]
      }
    },
    "authoring": {
      "type": "object",
      "properties": {
        "autoAxisRelations": {
          "type": "boolean"
        },
        "axisGuideMode": {
          "enum": [
            "global",
            "local"
          ]
        },
        "snap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "strength": {
              "enum": [
                "off",
                "light",
                "normal",
                "strong",
                "training"
              ]
            },
            "scopeMode": {
              "enum": [
                "smart",
                "manual"
              ]
            },
            "holdToDisableKey": {
              "type": "string"
            },
            "cycleKey": {
              "type": "string"
            },
            "gridSteps": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "gridMinScreenPx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gridUseSpeedBoost": {
              "type": "boolean"
            },
            "profiles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "screenTolerancePx": {
                    "type": "number",
                    "minimum": 0
                  },
                  "intersectionTolerancePx": {
                    "type": "number",
                    "minimum": 0
                  },
                  "pointBiasPx": {
                    "type": "number",
                    "minimum": 0
                  },
                  "intersectionBiasPx": {
                    "type": "number",
                    "minimum": 0
                  },
                  "projectionBiasPx": {
                    "type": "number",
                    "minimum": 0
                  },
                  "axisBiasPx": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maxIntersectionSources": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gridMaxStep": {
                    "type": "number",
                    "minimum": 0
                  },
                  "gridMaxSteps": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "sketchWorldTolerance": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "showLabels": {
                    "type": "boolean"
                  },
                  "includeSurfaceTargets": {
                    "enum": [
                      false,
                      "corners",
                      "edges",
                      "faces"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "scope": {
              "type": "object",
              "properties": {
                "components": {
                  "type": "boolean"
                },
                "members": {
                  "type": "boolean"
                },
                "plates": {
                  "type": "boolean"
                },
                "fasteners": {
                  "type": "boolean"
                },
                "welds": {
                  "type": "boolean"
                },
                "features": {
                  "type": "boolean"
                },
                "trimJoints": {
                  "type": "boolean"
                },
                "workPoints": {
                  "type": "boolean"
                },
                "referencePlanes": {
                  "type": "boolean"
                },
                "grids": {
                  "type": "boolean"
                },
                "activeSketch": {
                  "type": "boolean"
                },
                "constructionGuides": {
                  "type": "boolean"
                },
                "selectedObjectsOnly": {
                  "type": "boolean"
                },
                "currentSmartComponentOnly": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "plateSketchDefaultNotchSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "plateSketchDefaultNotchMaxSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "plateSketchDefaultCircleRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "plateSketchDefaultPlateThickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "plateSketchDefaultArcSweepDegrees": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "globalAxisSnapSpan": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "globalAxisGuideSpan": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "activeReferenceMemberLimit": {
          "type": "integer",
          "minimum": 0
        },
        "snapAxisHighlightSpan": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "snapAxisExtensionPadding": {
          "type": "number",
          "minimum": 0
        },
        "defaultColumnHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "previewOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "beamColor": {
          "$ref": "#/$defs/color"
        },
        "columnColor": {
          "$ref": "#/$defs/color"
        },
        "previewColor": {
          "$ref": "#/$defs/color"
        },
        "snapColor": {
          "$ref": "#/$defs/color"
        },
        "workPlaneColor": {
          "$ref": "#/$defs/color"
        },
        "workPlaneSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lineWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "handleLineWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "platePreviewColor": {
          "$ref": "#/$defs/color"
        },
        "plateGuideSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "plateDepthGuideLength": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "manipulator": {
          "type": "object",
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "coordinateSpace": {
              "enum": [
                "global",
                "local"
              ]
            },
            "translation": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "adaptive",
                    "fixed"
                  ]
                },
                "fixedStep": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minStep": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxStep": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "targetPixelsPerStep": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "allowedSteps": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "additionalProperties": false
            },
            "rotation": {
              "type": "object",
              "properties": {
                "stepDegrees": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "screen": {
              "type": "object",
              "properties": {
                "axisLengthPx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "arrowHeadPx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "axisStartOffsetPx": {
                  "type": "number",
                  "minimum": 0
                },
                "ringCenterOffsetPx": {
                  "type": "number",
                  "minimum": 0
                },
                "ringRadiusPx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "ringGapPx": {
                  "type": "number",
                  "minimum": 0
                },
                "ringArrowHeadPx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hitTolerancePx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hubRadiusPx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "spaceToggleRadiusPx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "spaceToggleOffsetPx": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "sheetMetalReliefEvaluator": {
            "enum": [
              "legacy",
              "charts-supported"
            ]
        }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": [
        "visibility",
        "background",
        "lighting",
        "edges",
        "dimensions",
        "fasteners",
        "curves"
      ],
      "properties": {
        "visibility": {
          "type": "object",
          "required": [
            "cuttingObjects",
            "fasteners",
            "grids",
            "referencePlanes"
          ],
          "properties": {
            "cuttingObjects": {
              "type": "boolean"
            },
            "fasteners": {
              "type": "boolean"
            },
            "grids": {
              "type": "boolean"
            },
            "referencePlanes": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "datum": {
          "type": "object",
          "properties": {
            "gridColor": {
              "$ref": "#/$defs/color"
            },
            "gridOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gridLabelColor": {
              "$ref": "#/$defs/color"
            },
            "gridLabelOffset": {
              "type": "number",
              "minimum": 0
            },
            "gridLabelTextHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "lighting": {
          "type": "object",
          "required": [
            "direction",
            "ambient",
            "diffuse"
          ],
          "properties": {
            "direction": {
              "$ref": "#/$defs/vec3"
            },
            "ambient": {
              "type": "number",
              "minimum": 0
            },
            "diffuse": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "edges": {
          "type": "object",
          "required": [
            "defaultColor",
            "plateColor",
            "fastenerHeadColor",
            "lineWidth"
          ],
          "properties": {
            "defaultColor": {
              "$ref": "#/$defs/color"
            },
            "plateColor": {
              "$ref": "#/$defs/color"
            },
            "fastenerHeadColor": {
              "$ref": "#/$defs/color"
            },
            "lineWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "dimensions": {
          "type": "object",
          "required": [
            "fontFamily",
            "fontWeight",
            "activeFontWeight",
            "textHeight",
            "minFontPx"
          ],
          "properties": {
            "fontFamily": {
              "type": "string",
              "minLength": 1
            },
            "fontWeight": {
              "$ref": "#/$defs/fontWeight"
            },
            "activeFontWeight": {
              "$ref": "#/$defs/fontWeight"
            },
            "textHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minFontPx": {
              "type": "number",
              "minimum": 0
            },
            "surfaceLift": {
              "type": "number",
              "minimum": 0
            },
            "hideBehindGeometry": {
              "type": "boolean"
            },
            "tooltipDelayMs": {
              "type": "number",
              "minimum": 0
            },
            "tooltipFontPx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tooltipMaxWidthPx": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "axes": {
          "type": "object",
          "required": [
            "visible",
            "padding",
            "minLength",
            "headSize",
            "xColor",
            "yColor",
            "zColor",
            "negativeColor"
          ],
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "padding": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minLength": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "headSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "xColor": {
              "$ref": "#/$defs/color"
            },
            "yColor": {
              "$ref": "#/$defs/color"
            },
            "zColor": {
              "$ref": "#/$defs/color"
            },
            "negativeColor": {
              "$ref": "#/$defs/color"
            }
          },
          "additionalProperties": false
        },
        "fasteners": {
          "type": "object",
          "required": [
            "length",
            "sides",
            "headRadiusFactor"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sides": {
              "type": "integer",
              "minimum": 3
            },
            "headRadiusFactor": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "lod": {
          "type": "object",
          "properties": {
            "detailPixelThreshold": {
              "type": "number",
              "minimum": 1
            },
            "maxAutoDetailObjects": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "curves": {
          "type": "object",
          "required": [
            "circleSegments",
            "segmentLength",
            "discSegments"
          ],
          "properties": {
            "circleSegments": {
              "type": "integer",
              "minimum": 3
            },
            "segmentLength": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "discSegments": {
              "type": "integer",
              "minimum": 3
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "required": [
        "showHud",
        "showMeta",
        "showResetButton",
        "title"
      ],
      "properties": {
        "showHud": {
          "type": "boolean"
        },
        "showMeta": {
          "type": "boolean"
        },
        "showResetButton": {
          "type": "boolean"
        },
        "title": {
          "enum": [
            "project-name"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "fontWeight": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "shortcutBinding": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    }
  }
}
