{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/api-register.schema.json",
  "title": "API Register Schema",
  "description": "Schema for the app-owned headless API register.",
  "type": "object",
  "required": ["$schema", "schema", "schemaVersion", "apis"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "bobercad-api-register" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "module", "description", "parameters", "returns"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1, "pattern": "^\\.\\.?/" },
          "description": { "type": "string", "minLength": 1 },
          "parameters": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "returns": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
