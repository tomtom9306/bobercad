{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/reference-point-cloud-chunk.schema.json",
  "title": "BoberCAD Reference Point Cloud Chunk Schema",
  "description": "Sidecar point payload for chunked canonical reference geometry, intended for large E57-style point-cloud imports.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "id",
    "kind",
    "objectId",
    "pointCount",
    "bounds",
    "points"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "bobercad-reference-point-cloud-chunk"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "const": "point-cloud"
    },
    "objectId": {
      "$ref": "#/$defs/id"
    },
    "pointCount": {
      "type": "integer",
      "minimum": 1
    },
    "bounds": {
      "$ref": "#/$defs/bounds"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vec3"
      }
    },
    "pointAttributes": {
      "$ref": "#/$defs/pointAttributes"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ]
    },
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      ]
    },
    "pointAttributes": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rgb"
          }
        },
        "intensities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "normals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vec3"
          }
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      },
      "additionalProperties": false
    }
  }
}
