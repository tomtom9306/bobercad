{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/reference-geometry.schema.json",
  "title": "Bobercad Reference Geometry Schema",
  "type": "object",
  "required": ["schema", "schemaVersion", "units", "source", "lines", "polylines", "meshes", "pointClouds"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "bobercad-reference-geometry" },
    "schemaVersion": { "const": "0.1" },
    "units": {
      "type": "object",
      "required": ["length"],
      "properties": { "length": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "source": { "type": "object", "additionalProperties": true },
    "layers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layer" } },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
    "polylines": { "type": "array", "items": { "$ref": "#/$defs/polyline" } },
    "meshes": { "type": "array", "items": { "$ref": "#/$defs/mesh" } },
    "pointClouds": { "type": "array", "items": { "$ref": "#/$defs/pointCloud" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "layer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "$ref": "#/$defs/opacity" }
      },
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "required": ["id", "points"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layer": { "$ref": "#/$defs/id" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "points": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/vec3" } }
      },
      "additionalProperties": false
    },
    "polyline": {
      "type": "object",
      "required": ["id", "points"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layer": { "$ref": "#/$defs/id" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "closed": { "type": "boolean" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/vec3" } }
      },
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "required": ["id", "vertices", "faces"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layer": { "$ref": "#/$defs/id" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "vertices": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vec3" } },
        "faces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 3, "items": { "type": "integer", "minimum": 0 } }
        }
      },
      "additionalProperties": false
    },
    "pointCloud": {
      "type": "object",
      "required": ["id", "points"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layer": { "$ref": "#/$defs/id" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "pointSize": { "type": "number", "minimum": 1 },
        "sourcePointCount": { "type": "integer", "minimum": 0 },
        "storedPointCount": { "type": "integer", "minimum": 0 },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vec3" } }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
