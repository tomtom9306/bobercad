{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/reference-geometry.schema.json",
  "title": "BoberCAD Reference Geometry Schema",
  "description": "Canonical read-only reference geometry produced by external translators from DXF, DWG, STEP, IFC, E57, or other source formats.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "asset",
    "layers",
    "objects",
    "chunks",
    "diagnostics"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "bobercad-reference-geometry"
    },
    "schemaVersion": {
      "const": "0.1.0"
    },
    "asset": {
      "$ref": "#/$defs/asset"
    },
    "layers": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/layer"
      }
    },
    "objects": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/referenceObject"
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "displayName": {
      "description": "Bounded UI display name without local paths, URI prefixes, traversal, encoded path separators, control characters, or leading/trailing whitespace.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\\\)(?![\\/])(?!.*[A-Za-z][A-Za-z0-9+.-]*:[\\/])(?!.*(?:^|[\\s\\\"'()])\\.\\.?[\\/])(?!.*[\\/]{2})(?!.*%(?:2[fF]|5[cC]))(?!.*[A-Za-z0-9_-][\\/][A-Za-z0-9_.-]+\\.[A-Za-z0-9]{1,8}).+$"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ]
    },
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      ]
    },
    "pointAttributes": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rgb"
          }
        },
        "intensities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "normals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vec3"
          }
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "dxf",
            "dwg",
            "step",
            "ifc",
            "e57",
            "e57pointcloud",
            "json",
            "unknown"
          ]
        },
        "fileName": {
          "description": "Path-free source basename only; local directories, URI prefixes, query/hash fragments, control characters, and traversal placeholders are not allowed.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!\\.\\.?$)(?!\\s)(?!.*\\s$)[^\\\\/:?#\\u0000-\\u001f\\u007f]{1,255}$"
        },
        "fileExtension": {
          "description": "Lowercase source file extension without a leading dot, preserving alias extensions such as p21, ifczip, or e57pc.",
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9_-]*$"
        },
        "requestedFormat": {
          "description": "Lowercase source format token requested by the caller or inferred from the input extension before canonical normalization.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "fileSizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "modifiedTime": {
          "type": "string",
          "format": "date-time"
        },
        "statFingerprint": {
          "description": "Cheap source identity derived from public source extension, size, and modified time; not a content checksum.",
          "type": "string",
          "minLength": 1,
          "pattern": "^stat-sha256:[0-9a-f]{64}$"
        },
        "checksum": {
          "description": "Verified source-content SHA-256 checksum emitted only by trusted translator steps, as 64 lowercase hexadecimal characters without a prefix.",
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "translator": {
          "description": "Trusted translator provenance: the checked-in built-in translator id, a safe lowercase machine token, or external:<adapter id>.",
          "type": "string",
          "minLength": 1,
          "anyOf": [
            {
              "const": "tools/reference-geometry/translate_reference_geometry.mjs"
            },
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            {
              "pattern": "^external:(?!__proto__$|prototype$|constructor$)[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          ]
        },
        "translatorVersion": {
          "description": "Short path-free translator version token.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "adapterKey": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "dxf"
              }
            },
            "required": [
              "format",
              "requestedFormat"
            ]
          },
          "then": {
            "properties": {
              "requestedFormat": {
                "enum": [
                  "dxf"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "dwg"
              }
            },
            "required": [
              "format",
              "requestedFormat"
            ]
          },
          "then": {
            "properties": {
              "requestedFormat": {
                "enum": [
                  "dwg"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "step"
              }
            },
            "required": [
              "format",
              "requestedFormat"
            ]
          },
          "then": {
            "properties": {
              "requestedFormat": {
                "enum": [
                  "step",
                  "stp",
                  "p21",
                  "stpnc"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "ifc"
              }
            },
            "required": [
              "format",
              "requestedFormat"
            ]
          },
          "then": {
            "properties": {
              "requestedFormat": {
                "enum": [
                  "ifc",
                  "ifcxml",
                  "ifczip"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "e57"
              }
            },
            "required": [
              "format",
              "requestedFormat"
            ]
          },
          "then": {
            "properties": {
              "requestedFormat": {
                "enum": [
                  "e57",
                  "e57pointcloud",
                  "e57pc"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "e57pointcloud"
              }
            },
            "required": [
              "format",
              "requestedFormat"
            ]
          },
          "then": {
            "properties": {
              "requestedFormat": {
                "enum": [
                  "e57",
                  "e57pointcloud",
                  "e57pc"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            },
            "required": [
              "format",
              "requestedFormat"
            ]
          },
          "then": {
            "properties": {
              "requestedFormat": {
                "enum": [
                  "json"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "dxf"
              }
            },
            "required": [
              "format",
              "fileExtension"
            ]
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "",
                  "dxf"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "dwg"
              }
            },
            "required": [
              "format",
              "fileExtension"
            ]
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "",
                  "dwg"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "step"
              }
            },
            "required": [
              "format",
              "fileExtension"
            ]
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "",
                  "step",
                  "stp",
                  "p21",
                  "stpnc"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "ifc"
              }
            },
            "required": [
              "format",
              "fileExtension"
            ]
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "",
                  "ifc",
                  "ifcxml",
                  "ifczip"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "e57"
              }
            },
            "required": [
              "format",
              "fileExtension"
            ]
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "",
                  "e57"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "e57pointcloud"
              }
            },
            "required": [
              "format",
              "fileExtension"
            ]
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "",
                  "e57"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            },
            "required": [
              "format",
              "fileExtension"
            ]
          },
          "then": {
            "properties": {
              "fileExtension": {
                "enum": [
                  "",
                  "json"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "unknown"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "not": {
              "required": [
                "requestedFormat"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "coordinateSystem": {
      "type": "object",
      "required": [
        "origin",
        "axisX",
        "axisY",
        "axisZ"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/vec3"
        },
        "axisX": {
          "$ref": "#/$defs/vec3"
        },
        "axisY": {
          "$ref": "#/$defs/vec3"
        },
        "axisZ": {
          "$ref": "#/$defs/vec3"
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source",
        "units",
        "coordinateSystem"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "units": {
          "enum": [
            "mm",
            "m",
            "in",
            "ft"
          ]
        },
        "coordinateSystem": {
          "$ref": "#/$defs/coordinateSystem"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "edgeColor": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pointSize": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "display": {
          "$ref": "#/$defs/display"
        }
      },
      "additionalProperties": false
    },
    "indexPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "indexLoop": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "referenceObject": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "line-set",
            "mesh",
            "point-cloud"
          ]
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "layer": {
          "$ref": "#/$defs/id"
        },
        "display": {
          "$ref": "#/$defs/display"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "pointTextColumns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pointAttributeFields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "colors",
                  "intensities",
                  "classifications",
                  "normals"
                ]
              }
            },
            "skippedCartesianInvalidPointCount": {
              "type": "integer",
              "minimum": 0
            },
            "skippedSphericalInvalidPointCount": {
              "type": "integer",
              "minimum": 0
            },
            "skippedAttributeInvalidPointCount": {
              "type": "integer",
              "minimum": 0
            },
            "objObject": {
              "type": "string",
              "minLength": 1
            },
            "objGroup": {
              "type": "string",
              "minLength": 1
            },
            "objMaterial": {
              "type": "string",
              "minLength": 1
            },
            "objMaterialLibrary": {
              "type": "string",
              "minLength": 1
            },
            "objUniformVertexColor": {
              "$ref": "#/$defs/color"
            },
            "objDisplayColorSource": {
              "enum": [
                "uniform-vertex-color"
              ]
            }
          },
          "additionalProperties": true
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "lineSegments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexPair"
          }
        },
        "faces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexLoop"
          }
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "pointAttributes": {
          "$ref": "#/$defs/pointAttributes"
        },
        "chunkIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "line-set"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "faces"
                  ]
                },
                {
                  "required": [
                    "points"
                  ]
                },
                {
                  "required": [
                    "pointAttributes"
                  ]
                },
                {
                  "required": [
                    "chunkIds"
                  ]
                }
              ]
            },
            "properties": {
              "vertices": {
                "minItems": 2
              }
            },
            "required": [
              "vertices",
              "lineSegments"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mesh"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lineSegments"
                  ]
                },
                {
                  "required": [
                    "points"
                  ]
                },
                {
                  "required": [
                    "pointAttributes"
                  ]
                },
                {
                  "required": [
                    "chunkIds"
                  ]
                }
              ]
            },
            "properties": {
              "vertices": {
                "minItems": 3
              }
            },
            "required": [
              "vertices",
              "faces"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "point-cloud"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "vertices"
                  ]
                },
                {
                  "required": [
                    "lineSegments"
                  ]
                },
                {
                  "required": [
                    "faces"
                  ]
                }
              ]
            },
            "oneOf": [
              {
                "not": {
                  "required": [
                    "chunkIds"
                  ]
                },
                "required": [
                  "points"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "points"
                      ]
                    },
                    {
                      "required": [
                        "pointAttributes"
                      ]
                    }
                  ]
                },
                "required": [
                  "chunkIds"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "objectId",
        "path",
        "pointCount"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "point-cloud"
          ]
        },
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "description": "Forward-slash relative path to a point-cloud chunk sidecar under the reference manifest directory. Absolute paths, URL schemes, query/fragment suffixes, Windows drive paths, backslashes, encoded separators, encoded dot segments, and . or .. segments are invalid.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!//)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\?#\\u0000-\\u001f\\u007f])(?!.*%(?![0-9A-Fa-f]{2}))(?!.*%(?:2[fF]|5[cC]))(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)(?:\\.|%2[eE]){1,2}(?:/|$)).+$"
        },
        "pointCount": {
          "type": "integer",
          "minimum": 1
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "description": "Safe machine-readable diagnostic token.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "message": {
          "description": "Bounded diagnostic text without local paths, URI prefixes, traversal, encoded path separators, or control characters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
