{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/frame-library.schema.json",
  "title": "Steel Frame Library Schema",
  "description": "Schema for reusable frame templates. Templates help author explicit project work points and objects but are not runtime geometry sources.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "library",
    "units",
    "frames"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "steel-frame-library"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "library": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "required": [
        "length",
        "angle"
      ],
      "properties": {
        "length": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "const": "deg"
        }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/frameTemplate"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "frameTemplate": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "localWorkPoints",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "localWorkPoints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/vec3"
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frameMember"
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frameGroup"
          }
        },
        "parameters": {
          "type": "object",
          "properties": {
            "preferredPatternType": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "frameGroup": {
      "type": "object",
      "required": [
        "role",
        "type"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "frameMember": {
      "type": "object",
      "required": [
        "role",
        "type",
        "start",
        "end"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "type": "number"
        },
        "cardinalPoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
