{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/fastener-library.schema.json",
  "title": "Steel Fastener Library Schema",
  "description": "Starter schema for bolt, blind bolt, hook bolt, anchor, stud, nut, and washer catalog data referenced by steel BIM project files.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "library",
    "units",
    "fasteners"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "steel-fastener-library"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "library": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "required": [
        "length"
      ],
      "properties": {
        "length": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fasteners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/fastener"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fastener": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "standard",
        "shank",
        "hole"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "lengths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "shank": {
          "type": "object",
          "required": [
            "diameter"
          ],
          "properties": {
            "diameter": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "hole": {
          "type": "object",
          "required": [
            "defaultDiameter",
            "shape"
          ],
          "properties": {
            "defaultDiameter": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "shape": {
              "type": "string",
              "minLength": 1
            },
            "tolerances": {
              "type": "object",
              "properties": {
                "tight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "normal": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "loose": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "head": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "acrossFlats": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "nut": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "acrossFlats": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "washer": {
          "type": "object",
          "properties": {
            "outerDiameter": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "thickness": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "blindEnd": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "requiresOrientation": {
              "type": "boolean"
            },
            "clearanceEnvelope": {
              "$ref": "#/$defs/clearanceEnvelope"
            }
          },
          "additionalProperties": false
        },
        "hook": {
          "type": "object",
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "opening": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "requiresOrientation": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clearanceEnvelope": {
      "type": "object",
      "required": [
        "width",
        "height",
        "length"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
