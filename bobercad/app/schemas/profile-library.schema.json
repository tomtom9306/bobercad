{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/profile-library.schema.json",
  "title": "Steel Profile Library Schema",
  "description": "Point-based profile library schema. Profile geometry is defined by closed 2D contours using [y, z] points.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "library",
    "units",
    "sectionCoordinateSystem",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "steel-profile-library"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "library": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "required": [
        "length",
        "angle"
      ],
      "properties": {
        "length": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "const": "deg"
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "massPerLength": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sectionCoordinateSystem": {
      "type": "object",
      "required": [
        "pointFormat",
        "sectionWidthAxis",
        "sectionDepthAxis"
      ],
      "properties": {
        "memberAxis": {
          "type": "string",
          "minLength": 1
        },
        "pointFormat": {
          "const": "[y, z]"
        },
        "sectionWidthAxis": {
          "type": "string",
          "minLength": 1
        },
        "sectionDepthAxis": {
          "type": "string",
          "minLength": 1
        },
        "positiveRotation": {
          "type": "string",
          "minLength": 1
        },
        "contourRule": {
          "type": "string",
          "minLength": 1
        },
        "solidContourOrientation": {
          "const": "counter-clockwise"
        },
        "voidContourOrientation": {
          "const": "clockwise"
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "designation",
        "profileType",
        "section"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "designation": {
          "type": "string",
          "minLength": 1
        },
        "profileType": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "properties": {
          "type": "object",
          "properties": {
            "area": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "massPerLength": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "type",
        "origin",
        "contours"
      ],
      "properties": {
        "type": {
          "const": "polygonal-section"
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "contours": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contour"
          }
        },
        "referencePoints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        },
        "semanticRefs": {
          "type": "object",
          "properties": {
            "regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "faces": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "edges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contour": {
      "type": "object",
      "required": [
        "id",
        "role",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "solid",
            "void"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
