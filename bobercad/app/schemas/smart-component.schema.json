{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/smart-component.schema.json",
  "title": "Smart Component Definition Schema",
  "description": "Validates one Smart Component folder config.json. Components are recipe/config/build code using only the public model authoring API.",
  "type": "object",
  "required": [
    "$schema",
    "type",
    "kind",
    "title",
    "version",
    "presets",
    "parameters",
    "components",
    "ui"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "recipe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recipeStep"
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "requiredPlateRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "enum": [
              "ghost"
            ]
          },
          "objectRoles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "ui": {
      "$ref": "#/$defs/ui"
    },
    "presets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "connection"
          }
        }
      },
      "then": {
        "required": [
          "interfaces"
        ]
      }
    }
  ],
  "$defs": {
    "recipeStep": {
      "type": "object",
      "required": [
        "operation",
        "inputs"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "auto": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "member-end-face",
                "member-web",
                "planar-face"
              ]
            },
            "faceRef": {
              "type": "string",
              "minLength": 1
            },
            "memberEnd": {
              "enum": [
                "start",
                "end"
              ]
            },
            "stationReference": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "member-web"
                  }
                }
              },
              "then": {
                "required": [
                  "faceRef"
                ],
                "properties": {
                  "faceRef": {
                    "const": "web-center-plane"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "planar-face"
                  }
                }
              },
              "then": {
                "required": [
                  "faceRef"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "stationReference"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "member-end-face"
                  }
                }
              },
              "then": {},
              "else": {
                "not": {
                  "required": [
                    "memberEnd"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "member-end-face"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "faceRef"
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "number",
            "positiveNumber",
            "nonNegativeNumber",
            "positiveInteger",
            "numberList",
            "object",
            "boolean",
            "catalogRef",
            "enum",
            "text"
          ]
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "itemMinimum": {
          "type": "number"
        },
        "itemExclusiveMinimum": {
          "type": "number"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "catalogRef"
              }
            }
          },
          "then": {
            "required": [
              "catalog"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "required": [
        "id",
        "parameter",
        "reference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ui": {
      "type": "object",
      "required": [
        "tabs"
      ],
      "properties": {
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uiTab"
          }
        }
      },
      "additionalProperties": true
    },
    "uiTab": {
      "type": "object",
      "required": [
        "id",
        "label",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uiItem"
          }
        }
      },
      "additionalProperties": false
    },
    "uiItem": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "diagnostics",
                "parameter",
                "section",
                "smartComponentOverrides",
                "smartComponentPlates",
                "smartComponentRoles",
                "stairComputedGeometry",
                "stairRouteModules"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "visibleWhen": {
              "type": "object",
              "additionalProperties": true
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uiItem"
              }
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "parameter"
                  }
                }
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "stairRouteModules"
                  }
                }
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "section"
                  }
                }
              },
              "then": {
                "required": [
                  "label",
                  "items"
                ]
              }
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "preset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "integer",
            "string"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
