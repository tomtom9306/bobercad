{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/material-library.schema.json",
  "title": "Steel Material Library Schema",
  "description": "Starter schema for material libraries referenced by steel BIM project files.",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "library",
    "units",
    "materials"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "steel-material-library"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "library": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "required": [
        "density",
        "stress"
      ],
      "properties": {
        "density": {
          "type": "string",
          "minLength": 1
        },
        "stress": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "material": {
      "type": "object",
      "required": [
        "id",
        "name",
        "materialType",
        "density"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "materialType": {
          "type": "string",
          "minLength": 1
        },
        "density": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nominalYieldStrength": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
