{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobercad/app/schemas/smart-component-register.schema.json",
  "title": "Smart Component Register Schema",
  "description": "Schema for a Smart Component library register. The register is the app-visible list of component folders.",
  "type": "object",
  "required": [
    "$schema",
    "libraryUi",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "libraryUi": {
      "type": "string",
      "minLength": 3,
      "pattern": "^\\./"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4,
        "pattern": "^\\./.+/$"
      }
    }
  },
  "additionalProperties": false
}
